<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements of Contents/Helpers/specular-decode-host (the sandboxed decode
     host), used by packaging/macos/build-dmg.sh when signing.

     disable-library-validation: the host loads the user's libheif (Homebrew, MacPorts) with
     dlopen at run time (crates/specular-decode-host/src/heif.rs). Those libraries are not signed
     by our team, so the hardened runtime's library validation would refuse them and HEIC would
     report "not installed". The host confines itself with Seatbelt (sandbox/macos.rs) right
     after loading them, before reading any request. The viewer keeps library validation
     (entitlements.plist).

     No App Sandbox entitlement: Seatbelt is applied by the host itself; the App Sandbox could
     only be inherited from an App-Sandboxed parent, and the viewer is not one. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
