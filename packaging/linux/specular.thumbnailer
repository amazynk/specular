# Freedesktop thumbnailer: lets file managers (Nautilus, Nemo, Caja, Thunar via tumbler's
# desktop-thumbnailer plugin, ...) show previews of the formats Specular decodes.
# Install to /usr/share/thumbnailers/specular.thumbnailer (system packages only: a sandboxed
# Flatpak cannot be run by the host's thumbnailer). `specular` must be on PATH.
# %i: input file, %o: output PNG, %s: requested size (long side, px).
[Thumbnailer Entry]
TryExec=specular
Exec=specular --thumbnail %i %o %s
