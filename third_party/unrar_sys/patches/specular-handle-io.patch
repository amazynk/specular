+// Specular: a positioned read at BorrowedPos; -1 on error, 0 at the end.
+int File::BorrowedRead(void *Data,size_t Size)
+{
+  if (Size>0x7fffffff)
+    Size=0x7fffffff;
+#ifdef _WIN_ALL
+  OVERLAPPED Ov;
+  memset(&Ov,0,sizeof(Ov));
+  Ov.Offset=(DWORD)(uint64)BorrowedPos;
+  Ov.OffsetHigh=(DWORD)((uint64)BorrowedPos>>32);
+  DWORD Read=0;
+  if (!ReadFile(hFile,Data,(DWORD)Size,&Read,&Ov))
+    return GetLastError()==ERROR_HANDLE_EOF ? 0:-1;
+#else
+  ssize_t Read;
+  do
+    Read=pread(hFile,Data,Size,(off_t)BorrowedPos);
+  while (Read<0 && errno==EINTR);
+  if (Read<0)
+    return -1;
+#endif
+  BorrowedPos+=(int64)Read;
+  return (int)Read;
+}
+
+
+// Specular: the size of a borrowed file, -1 on error.
+int64 File::BorrowedLength()
+{
+#ifdef _WIN_ALL
+  LARGE_INTEGER Size;
+  if (!GetFileSizeEx(hFile,&Size))
+    return -1;
+  return (int64)Size.QuadPart;
+#else
+  struct stat st;
+  if (fstat(hFile,&st)!=0)
+    return -1;
+  return (int64)st.st_size;
+#endif
+}
