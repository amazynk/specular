+// Specular: a handle from the open hook, read only.
+bool File::BorrowedOpen(const std::wstring &Name,uint Mode)
+{
+  if ((Mode & (FMF_UPDATE|FMF_WRITE))!=0)
+    return false;
+  std::string NameU;
+  WideToUtf(Name,NameU);
+  intptr_t Handle=SpecularHook(NameU.c_str(),NameU.size());
+  if (Handle==-1)
+  {
+    ErrorType=FILE_NOTFOUND;
+    return false;
+  }
+  hFile=(FileHandle)Handle;
+  Borrowed=true;
+  BorrowedPos=0;
+  NewFile=false;
+  HandleType=FILE_HANDLENORMAL;
+  SkipClose=false;
+  FileName=Name;
+  TruncatedAfterReadError=false;
+  return true;
+}
