--- a/vendor/unrar/file.cpp
+++ b/vendor/unrar/file.cpp
@@ -23,6 +23,12 @@
   return SpecularHook!=NULL;
 }
 
+// Specular (specular-password.patch): the hook, for dll.cpp; -1 when none is set.
+intptr_t SpecularUnrarCallHook(const char *Name,size_t NameLength)
+{
+  return SpecularHook==NULL ? -1:SpecularHook(Name,NameLength);
+}
+
