 {
   hFile=FILE_BAD_HANDLE;
--- a/vendor/unrar/dll.cpp
+++ b/vendor/unrar/dll.cpp
@@ -1,5 +1,34 @@
 #include "rar.hpp"
 
+// Specular modification (third_party/unrar_sys/patches/specular-password.patch): the
+// password of an encrypted archive comes from the embedding program's open hook, asked for
+// the reserved names "\x01password/0", "\x01password/1", ... (one byte of UTF-8 each, -1
+// past the end; no byte is ever 0), before the archive is opened, so encrypted headers
+// (RAR -hp) and encrypted files both use it. It never passes through a C string, the
+// locale's character set or RARSetPassword, and every copy is wiped.
+intptr_t SpecularUnrarCallHook(const char *Name,size_t NameLength);
+
+static void SpecularPassword(SecPassword &Password)
+{
+  std::string Utf;
+  for (size_t I=0;I<MAXPASSWORD*4;I++)
+  {
+    std::string Name="\x01password/"+std::to_string(I);
+    intptr_t B=SpecularUnrarCallHook(Name.c_str(),Name.size());
+    if (B<=0 || B>255)
+      break;
+    Utf.push_back((char)B);
+  }
+  if (!Utf.empty())
+  {
+    std::wstring Wide;
+    UtfToWide(Utf.c_str(),Wide);
+    Password.Set(Wide.c_str());
+    cleandata(Wide);
+  }
+  cleandata(&Utf[0],Utf.size());
+}
+
 static int RarErrorToDll(RAR_EXIT ErrCode);
 
