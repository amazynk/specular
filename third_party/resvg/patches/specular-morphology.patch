+/// `out[i]` = `combine` over `line[i - before .. i - before + n]`, positions outside the line
+/// being `identity`.
+fn window(
+    line: &[RGBA8],
+    n: usize,
+    before: usize,
+    identity: RGBA8,
+    combine: fn(RGBA8, RGBA8) -> RGBA8,
+    s: &mut Scratch,
+    out: &mut Vec<RGBA8>,
+) {
+    let len = line.len();
+    // The padded line starts `before` cells early and is a whole number of `n`-blocks long.
+    let total = (len + n - 1).div_ceil(n) * n;
+    s.padded.clear();
+    s.padded.resize(before, identity);
+    s.padded.extend_from_slice(line);
+    s.padded.resize(total, identity);
+    s.prefix.clear();
+    s.prefix.extend_from_slice(&s.padded);
+    s.suffix.clear();
+    s.suffix.extend_from_slice(&s.padded);
+    for block in (0..total).step_by(n) {
+        for j in block + 1..block + n {
+            s.prefix[j] = combine(s.prefix[j - 1], s.padded[j]);
+        }
+        for j in (block..block + n - 1).rev() {
+            s.suffix[j] = combine(s.suffix[j + 1], s.padded[j]);
+        }
+    }
+    out.clear();
+    out.extend((0..len).map(|i| combine(s.suffix[i], s.prefix[i + n - 1])));
+}
