# machine-drafted, needs native review
# Vet, orthopaedic and cephalometric geometry in the measuring tool. Every point is placed
# by hand; nothing is detected or graded.

measure-tool-geometry = Geometria
measure-tool-hint-geometry = Escolha um modelo e coloque cada ponto que ele pedir.
measure-tool-template = Modelo: { $name }

geometry-prompt = { $template }, ponto { $n } de { $total }: { $point }
geometry-readout = { $name }: { $value }
geometry-value-angle = { $value }°
geometry-value-vertebrae = { $value } v
geometry-extrapolated = { $value } (além de T9, estimado)
geometry-degenerate = Pontos muito próximos ou alinhados. Mova um ponto.
geometry-moved = Ponto movido. { $value }
# machine-drafted, needs native review
geometry-picked = Ponto { $point } apanhado. As setas movem-no, com Shift em passos maiores. Espaço pousa-o, Esc devolve-o ao lugar.
geometry-put-back = Ponto devolvido ao lugar.

# Templates.
geometry-vhs = Escala vertebral cardíaca (VHS)
geometry-vlas = Tamanho vertebral do aurícula esquerda (VLAS)
geometry-norberg = Ângulo de Norberg
geometry-tpa = Ângulo do planalto tibial (TPA)
geometry-distraction-index = Índice de distração
