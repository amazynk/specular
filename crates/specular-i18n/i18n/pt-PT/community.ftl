# The Specular Discord server: the toolbar button, its Settings name, the palette and About.
# machine-drafted, needs native review

toolbar-discord = Aderir ao Discord do { -app-name }
toolbar-discord-help = Abrir o servidor do { -app-name } no Discord no browser.
settings-viewing-toolbar-items-discord = { -app-name } no Discord

# The other apps by the same people: About names them, and "Get …" opens an app's page in
# the browser. Pagebara, Dozed and Amazynk are names and stay as they are.
# machine-drafted, needs native review

about-more-apps = Mais da Amazynk
about-more-apps-pagebara = Pagebara: um visualizador e editor de PDF rápido e privado. Para Linux, Windows e macOS.
about-more-apps-dozed = Dozed: congela as aplicações de ambiente de trabalho do Linux para as quais não está a olhar, para que deixem de acordar a CPU.
palette-get-pagebara = Obter o Pagebara
palette-get-pagebara-help = Abrir no browser a página do Pagebara, um visualizador e editor de PDF. As transferências estão lá.
palette-get-dozed = Obter o Dozed
palette-get-dozed-help = Abrir no browser a página do Dozed, que congela aplicações em segundo plano no Linux. As transferências estão lá.

# Settings › More from Amazynk: a row for each app, named for it, with the same button.
settings-section-amazynk = { about-more-apps }
settings-amazynk-get-zynk = Zynk
settings-amazynk-get-zynk-help = O Zynk é uma app gratuita para Mac, Windows, Linux, iPhone e Android. Envia fotografias, vídeos e pastas inteiras diretamente para os seus outros dispositivos e para outras pessoas, de qualquer tamanho.
settings-amazynk-get-zynk-button = { zynk-get }
settings-amazynk-get-pagebara = Pagebara
settings-amazynk-get-pagebara-help = Um visualizador e editor de PDF rápido e privado. Para Linux, Windows e macOS.
settings-amazynk-get-pagebara-button = { palette-get-pagebara }
settings-amazynk-get-dozed = Dozed
settings-amazynk-get-dozed-help = Congela as aplicações de ambiente de trabalho do Linux para as quais não está a olhar, para que deixem de acordar a CPU.
settings-amazynk-get-dozed-button = { palette-get-dozed }
