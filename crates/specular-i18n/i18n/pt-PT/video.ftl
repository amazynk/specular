transport-loop-on = Repetir o filme
transport-loop-off = Parar de repetir
transport-mute = Desativar som
transport-unmute = Ativar som
transport-volume = Volume

## Avisos

# $percent é um número inteiro, p. ex. 80.
toast-volume = Volume { PERCENT($percent) }
toast-muted = Som desativado
toast-unmuted = Som ativado
toast-video-loop-on = A repetir o filme
toast-video-loop-off = A reproduzir o filme uma vez
# Mostrado uma vez por filme quando não há dispositivo de som ou este desaparece; o filme continua.
toast-no-sound-device = Nenhum dispositivo de som: reprodução sem som
toast-sound-device-lost = O dispositivo de som desapareceu: reprodução sem som
# O som usa uma codificação que esta versão não reproduz; $codec nomeia-a, p. ex. AAC.
toast-sound-unsupported = Reprodução sem som: o som { $codec } ainda não é suportado
# machine-drafted, needs native review
# The movie's sound decoder stopped part way; $reason is error-reason-internal.
toast-sound-stopped = O som parou: { $reason }

