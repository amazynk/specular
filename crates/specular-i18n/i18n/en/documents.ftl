## Books (EPUB): the table of contents panel (Alt+T).

contents-title = Contents
# Toast when Alt+T is pressed over a file without a table of contents.
contents-none = This file has no table of contents.

## Fonts: the specimen page (TTF, OTF, TTC/OTC, WOFF, WOFF2).

# The specimen's accessible name.
font-specimen = Specimen of { $family }
# Shown when the font names no family.
font-unnamed = Unnamed font
font-designer = Designer: { $value }
font-foundry = Foundry: { $value }
font-licence = Licence: { $value }
font-licence-url = Licence URL: { $value }
# A sentence using every letter of the alphabet, shown at several sizes in the font. Use one
# for the language (translators: any common pangram of your language).
font-pangram = The quick brown fox jumps over the lazy dog. 0123456789
# Heading of the glyph grid: "Glyphs 1–256 of 1,024".
font-glyphs-range = Glyphs { $first }–{ $last } of { $count }
font-glyphs-none = No glyphs
font-glyphs-previous = Previous glyphs
font-glyphs-next = Next glyphs
# The row of colour glyphs drawn in colour.
font-colour-row = Colour glyphs
font-note-colr0 = Colour glyphs are drawn in colour in the row below; text above is in one colour.
font-note-colr1 = COLR version 1 glyphs (gradients) are drawn in one colour: the text stack draws only COLR version 0 layers in colour.
font-note-bitmaps = Bitmap colour glyphs are drawn in colour in the row below; text above is in one colour.
font-note-svg = SVG colour glyphs are drawn in one colour: the text stack does not read SVG glyphs.
font-note-no-glyphs = This font has no outlines or bitmaps to draw.
font-note-bitmap-only = This font has only black-and-white bitmaps, which the text stack does not draw.
