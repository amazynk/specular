develop-retouch-outlines-hidden = Spot outlines hidden
palette-develop-spot-outlines = Show or hide spot outlines
palette-develop-spot-outlines-help = Retouch: the outlines of every spot on the picture.
# Placing spots with the keyboard crosshair. $tool is the tool's name (Heal, Clone…).
develop-retouch-cross-on = Crosshair on. Arrow keys move it, Enter places a spot ({ $tool }), Esc puts it away.
develop-retouch-cross-off = Crosshair off
# Where the crosshair is, in percent of the picture's width and height.
develop-retouch-cross-at = { PERCENT($x) } across, { PERCENT($y) } down
# $spot is the spot's name, e.g. "3. Heal".
develop-retouch-cross-placed = { $spot } placed
develop-retouch-cross-closed = Open the Retouch card to place spots.
develop-retouch-cross-full = No more spots fit on this photo.
palette-develop-spot-crosshair = Place retouch spots with the keyboard
palette-develop-spot-crosshair-help = Retouch: arrows move a crosshair, Enter places a spot.
