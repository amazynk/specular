# Playing a movie or sound file on a TV or speaker on the local network (DLNA/UPnP).
# Devices are named by their own names; no product names or logos.

palette-cast-menu = Play on…
palette-cast-menu-help = Play this on a TV or speaker on your network.
# The player's menu of devices (its name for screen readers).
cast-menu = Play on
# The More menu's row that opens it.
cast-play-on = Play on…
# The first row: play here, not on a device.
cast-this-device = This device
cast-searching = Looking for devices…
cast-none-found = No devices found. Search again
cast-search-again = Search again
cast-network-off = Network is off in Settings › Privacy
# The card over the picture; $device is the device's own name.
cast-playing-on = Playing on { $device }
cast-stop = Stop casting
cast-connecting = Connecting…
cast-paused = Paused
cast-loading = Loading…
cast-finished = Finished
toast-cast-back = Back on this device
# $device is the device's name; $kind the file's type (video/webm).
toast-cast-not-accepted = { $device } can't play this type of file ({ $kind }).
# $device is the device's name; $reason one of the cast-error- messages.
toast-cast-failed = Playing on { $device } stopped: { $reason }
toast-cast-refused = { $device } refused that: { $reason }
toast-cast-normal-speed = { $device } plays at normal speed only.
cast-error-network-off = the network is off.
cast-error-unreachable = the device can't be reached.
cast-error-timeout = the device didn't answer.
# $code is the device's own error number.
cast-error-refused = the device said no (error { $code }).
cast-error-broken = the device's answer made no sense.
cast-error-file = the file can't be shared.
# A row in the "Play on…" menu when picture subtitles (Blu-ray, DVD, DVB) are chosen.
cast-subtitles-pictures = Picture subtitles stay here: devices take text subtitles only.
