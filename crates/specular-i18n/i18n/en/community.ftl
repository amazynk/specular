# The Specular Discord server: the toolbar button, its Settings name, the palette and About.

toolbar-discord = Join the { -app-name } Discord
toolbar-discord-help = Open the { -app-name } Discord server in your browser.
settings-viewing-toolbar-items-discord = { -app-name } on Discord

# The other apps by the same people: About names them, and "Get …" (About's buttons, the
# palette, the Help menu on macOS) opens an app's page in the browser. Pagebara, Dozed and
# Amazynk are names and stay as they are.

about-more-apps = More from Amazynk
about-more-apps-pagebara = Pagebara: a fast, private PDF viewer and editor. For Linux, Windows and macOS.
about-more-apps-dozed = Dozed: freezes the Linux desktop apps you are not looking at, so they stop waking the CPU.
palette-get-pagebara = Get Pagebara
palette-get-pagebara-help = Open the page of Pagebara, a PDF viewer and editor, in your browser. Its downloads are there.
palette-get-dozed = Get Dozed
palette-get-dozed-help = Open the page of Dozed, which freezes background apps on Linux, in your browser. Its downloads are there.

# Settings › More from Amazynk: a row for each app, named for it, with the same button.
settings-section-amazynk = { about-more-apps }
settings-amazynk-get-zynk = Zynk
settings-amazynk-get-zynk-help = Zynk is a free app for Mac, Windows, Linux, iPhone and Android. It sends photos, videos and whole folders straight to your other devices and to other people, at any size.
settings-amazynk-get-zynk-button = { zynk-get }
settings-amazynk-get-pagebara = Pagebara
settings-amazynk-get-pagebara-help = A fast, private PDF viewer and editor. For Linux, Windows and macOS.
settings-amazynk-get-pagebara-button = { palette-get-pagebara }
settings-amazynk-get-dozed = Dozed
settings-amazynk-get-dozed-help = Freezes the Linux desktop apps you are not looking at, so they stop waking the CPU.
settings-amazynk-get-dozed-button = { palette-get-dozed }
