## Sound output: the device sound plays on, and the speakers.

settings-viewing-sound-output-device = Sound output
settings-viewing-sound-output-device-help = The device sound plays on. System default follows the system’s choice. If the chosen device goes, sound moves to the default and comes back when the device does.
settings-viewing-sound-output-device-default = System default
settings-viewing-sound-channels = Speakers
settings-viewing-sound-channels-help = 5.1 and 7.1 sound plays to each speaker when the device has them; otherwise it is mixed down to stereo. Automatic asks the device. On Linux the system’s mixer hides the speakers: choose 5.1 or 7.1.
settings-viewing-sound-channels-auto = Automatic
settings-viewing-sound-channels-stereo = Stereo
settings-viewing-sound-channels-surround-5-1 = 5.1
settings-viewing-sound-channels-surround-7-1 = 7.1

sound-output-default = System default
sound-output-stereo = stereo

player-output = Sound output
player-output-open = Output: { $device }…
player-speakers = Speakers: { $speakers }

toast-sound-output = Sound output: { $device }
toast-sound-speakers = Speakers: { $speakers }
toast-sound-output-gone = { $device } is gone. Sound plays on the system default.
toast-sound-output-back = Sound is back on { $device }.
toast-sound-output-default = The sound device is gone. Sound plays on the system default.

info-sound-output = Output
info-sound-output-value = { $device }, { $rate } kHz, { $channels }
info-sound-output-resampled = Resampled from { $rate } kHz
info-sound-output-downmixed = Downmixed from { $channels }
