# machine-drafted, needs native review

## Books (EPUB): the table of contents panel (Alt+T).

contents-title = Obsah
# Toast when Alt+T is pressed over a file without a table of contents.
contents-none = Tento soubor nemá obsah.

## Fonts: the specimen page (TTF, OTF, TTC/OTC, WOFF, WOFF2).

# The specimen's accessible name.
font-specimen = Ukázka písma { $family }
# Shown when the font names no family.
font-unnamed = Nepojmenované písmo
font-designer = Návrhář: { $value }
font-foundry = Písmolijna: { $value }
font-licence = Licence: { $value }
font-licence-url = Adresa URL licence: { $value }
# A sentence using every letter of the alphabet, shown at several sizes in the font. Use one
# for the language (translators: any common pangram of your language).
font-pangram = Příliš žluťoučký kůň úpěl ďábelské ódy. 0123456789
# Heading of the glyph grid: "Glyphs 1–256 of 1,024".
font-glyphs-range = Glyfy { $first }–{ $last } z { $count }
font-glyphs-none = Žádné glyfy
font-glyphs-previous = Předchozí glyfy
font-glyphs-next = Další glyfy
# The row of colour glyphs drawn in colour.
font-colour-row = Barevné glyfy
font-note-colr0 = Barevné glyfy se kreslí barevně v řádku níže; text nad ním je jednobarevný.
font-note-colr1 = Glyfy COLR verze 1 (přechody) se kreslí jednobarevně: vykreslování textu kreslí barevně jen vrstvy COLR verze 0.
font-note-bitmaps = Barevné bitmapové glyfy se kreslí barevně v řádku níže; text nad ním je jednobarevný.
font-note-svg = Barevné glyfy SVG se kreslí jednobarevně: vykreslování textu glyfy SVG nečte.
font-note-no-glyphs = Toto písmo nemá žádné obrysy ani bitmapy ke kreslení.
font-note-bitmap-only = Toto písmo má jen černobílé bitmapy, které vykreslování textu nekreslí.
