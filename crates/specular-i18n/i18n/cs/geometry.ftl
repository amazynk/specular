# machine-drafted, needs native review
# Vet, orthopaedic and cephalometric geometry in the measuring tool. Every point is placed
# by hand; nothing is detected or graded.

measure-tool-geometry = Geometrie
measure-tool-hint-geometry = Vyberte šablonu a pak umístěte každý bod, o který požádá.
measure-tool-template = Šablona: { $name }

geometry-prompt = { $template }, bod { $n } z { $total }: { $point }
geometry-readout = { $name }: { $value }
geometry-value-angle = { $value }°
geometry-value-vertebrae = { $value } v
geometry-extrapolated = { $value } (za T9, odhad)
geometry-degenerate = Body jsou příliš blízko nebo na jedné přímce. Posuňte bod.
geometry-moved = Bod přesunut. { $value }
# machine-drafted, needs native review
geometry-picked = Bod { $point } zvednut. Šipky jím posouvají, se Shift po větších krocích. Mezerník jej položí, Esc jej vrátí zpět.
geometry-put-back = Bod vrácen zpět.

# Templates.
