# machine-drafted, needs native review

## Books (EPUB): the table of contents panel (Alt+T).

contents-title = Table des matières
# Toast when Alt+T is pressed over a file without a table of contents.
contents-none = Ce fichier n’a pas de table des matières.

## Fonts: the specimen page (TTF, OTF, TTC/OTC, WOFF, WOFF2).

# The specimen's accessible name.
font-specimen = Spécimen de { $family }
# Shown when the font names no family.
font-unnamed = Police sans nom
font-designer = Dessinateur : { $value }
font-foundry = Fonderie : { $value }
font-licence = Licence : { $value }
font-licence-url = URL de la licence : { $value }
# A sentence using every letter of the alphabet, shown at several sizes in the font. Use one
# for the language (translators: any common pangram of your language).
font-pangram = Portez ce vieux whisky au juge blond qui fume. 0123456789
# Heading of the glyph grid: "Glyphs 1–256 of 1,024".
font-glyphs-range = Glyphes { $first }–{ $last } sur { $count }
font-glyphs-none = Aucun glyphe
font-glyphs-previous = Glyphes précédents
font-glyphs-next = Glyphes suivants
# The row of colour glyphs drawn in colour.
font-colour-row = Glyphes en couleur
font-note-colr0 = Les glyphes en couleur sont dessinés en couleur dans la ligne ci-dessous ; le texte au-dessus est d’une seule couleur.
font-note-colr1 = Les glyphes COLR version 1 (dégradés) sont dessinés d’une seule couleur : le moteur de texte ne dessine en couleur que les calques COLR version 0.
font-note-bitmaps = Les glyphes bitmap en couleur sont dessinés en couleur dans la ligne ci-dessous ; le texte au-dessus est d’une seule couleur.
font-note-svg = Les glyphes SVG en couleur sont dessinés d’une seule couleur : le moteur de texte ne lit pas les glyphes SVG.
font-note-no-glyphs = Cette police n’a ni contours ni bitmaps à dessiner.
font-note-bitmap-only = Cette police n’a que des bitmaps noir et blanc, que le moteur de texte ne dessine pas.
