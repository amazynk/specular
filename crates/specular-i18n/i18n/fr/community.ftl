# The Specular Discord server: the toolbar button, its Settings name, the palette and About.
# machine-drafted, needs native review

toolbar-discord = Rejoindre le Discord de { -app-name }
toolbar-discord-help = Ouvrir le serveur Discord de { -app-name } dans le navigateur.
settings-viewing-toolbar-items-discord = { -app-name } sur Discord

# The other apps by the same people: About names them, and "Get …" opens an app's page in
# the browser. Pagebara, Dozed and Amazynk are names and stay as they are.
# machine-drafted, needs native review

about-more-apps = Autres applications d’Amazynk
about-more-apps-pagebara = Pagebara : une visionneuse et un éditeur de PDF rapides et privés. Pour Linux, Windows et macOS.
about-more-apps-dozed = Dozed : fige les applications de bureau Linux que vous ne regardez pas, pour qu’elles cessent de réveiller le processeur.
palette-get-pagebara = Obtenir Pagebara
palette-get-pagebara-help = Ouvrir dans le navigateur la page de Pagebara, une visionneuse et un éditeur de PDF. Les téléchargements s’y trouvent.
palette-get-dozed = Obtenir Dozed
palette-get-dozed-help = Ouvrir dans le navigateur la page de Dozed, qui fige les applications en arrière-plan sous Linux. Les téléchargements s’y trouvent.

# Settings › More from Amazynk: a row for each app, named for it, with the same button.
settings-section-amazynk = { about-more-apps }
settings-amazynk-get-zynk = Zynk
settings-amazynk-get-zynk-help = Zynk est une app gratuite pour Mac, Windows, Linux, iPhone et Android. Elle envoie photos, vidéos et dossiers entiers directement vers vos autres appareils et à d’autres personnes, quelle que soit leur taille.
settings-amazynk-get-zynk-button = { zynk-get }
settings-amazynk-get-pagebara = Pagebara
settings-amazynk-get-pagebara-help = Une visionneuse et un éditeur de PDF rapides et privés. Pour Linux, Windows et macOS.
settings-amazynk-get-pagebara-button = { palette-get-pagebara }
settings-amazynk-get-dozed = Dozed
settings-amazynk-get-dozed-help = Fige les applications de bureau Linux que vous ne regardez pas, pour qu’elles cessent de réveiller le processeur.
settings-amazynk-get-dozed-button = { palette-get-dozed }
