# machine-drafted, needs native review
# Vet, orthopaedic and cephalometric geometry in the measuring tool. Every point is placed
# by hand; nothing is detected or graded.

measure-tool-geometry = Géométrie
measure-tool-hint-geometry = Choisissez un modèle, puis placez chaque point demandé.
measure-tool-template = Modèle : { $name }

geometry-prompt = { $template }, point { $n } sur { $total } : { $point }
geometry-readout = { $name } : { $value }
geometry-value-angle = { $value }°
geometry-value-vertebrae = { $value } v
geometry-extrapolated = { $value } (au-delà de T9, estimé)
geometry-degenerate = Points trop proches ou alignés. Déplacez un point.
geometry-moved = Point déplacé. { $value }
# machine-drafted, needs native review
geometry-picked = Point { $point } saisi. Les flèches le déplacent, Shift par pas plus grands. Espace le pose, Esc le remet en place.
geometry-put-back = Point remis en place.

# Templates.
geometry-vhs = Score vertébral cardiaque (VHS)
