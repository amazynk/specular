transport-loop-on = Lire le film en boucle
transport-loop-off = Arrêter la boucle
transport-mute = Couper le son
transport-unmute = Rétablir le son
transport-volume = Volume

## Notifications

# $percent est un nombre entier, p. ex. 80.
toast-volume = Volume { PERCENT($percent) }
toast-muted = Son coupé
toast-unmuted = Son rétabli
toast-video-loop-on = Film en boucle
toast-video-loop-off = Film lu une fois
# Affiché une fois par film s’il n’y a pas de périphérique audio ou s’il disparaît ; le film continue.
toast-no-sound-device = Aucun périphérique audio : lecture sans son
toast-sound-device-lost = Le périphérique audio a disparu : lecture sans son
# Le son du film utilise un codage que cette version ne sait pas lire ; $codec le nomme, p. ex. AAC.
toast-sound-unsupported = Lecture sans son : le son { $codec } n’est pas encore pris en charge
# machine-drafted, needs native review
# The movie's sound decoder stopped part way; $reason is error-reason-internal.
toast-sound-stopped = Le son s’est arrêté : { $reason }

