toast-sound-device-lost = サウンドデバイスが見つからなくなりました：音声なしで再生します
# このバージョンで再生できない音声形式です。$codec はその名前（例：AAC）。
toast-sound-unsupported = 音声なしで再生します：{ $codec } 音声はまだ再生できません
# machine-drafted, needs native review
# The movie's sound decoder stopped part way; $reason is error-reason-internal.
