# machine-drafted, needs native review
# Vet, orthopaedic and cephalometric geometry in the measuring tool. Every point is placed
# by hand; nothing is detected or graded.

measure-tool-geometry = 幾何計測
measure-tool-hint-geometry = テンプレートを選び、指示された各点を配置します。
measure-tool-template = テンプレート: { $name }

geometry-prompt = { $template }、点 { $n }/{ $total }: { $point }
geometry-readout = { $name }: { $value }
geometry-value-angle = { $value }°
geometry-value-vertebrae = { $value } 椎体
geometry-extrapolated = { $value }（T9 より先、推定）
geometry-degenerate = 点が近すぎるか、一直線上にあります。点を動かしてください。
geometry-moved = 点を移動しました。{ $value }
# machine-drafted, needs native review
geometry-picked = { $point } を持ち上げました。矢印キーで移動、Shift で大きく移動します。Space で置き、Esc で元に戻します。
geometry-put-back = 点を元に戻しました。

# Templates.
geometry-vhs = 椎骨心臓サイズ（VHS）
geometry-vlas = 椎骨左心房サイズ（VLAS）
geometry-norberg = ノルベルグ角
