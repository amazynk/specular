# Specular — Batch convert (DESIGN.md §6.5). machine-drafted, needs native review
# Every output is a new file; the sources are never changed.

palette-convert = 转换…

## Settings → Convert
settings-section-convert = 转换
settings-convert-format = 格式
settings-convert-format-help = “转换…”写入的格式。PNG 和 TIFF 为无损；WebP 和 JPEG XL 可以是无损或有损。
settings-convert-format-jpeg = JPEG
settings-convert-format-png = PNG
settings-convert-format-webp = WebP
settings-convert-format-jxl = JPEG XL
settings-convert-format-tiff = TIFF
settings-convert-jpeg-quality = JPEG 质量
settings-convert-jpeg-quality-help = 数值越高，保留的细节越多，文件也越大。90 时已很难与原图区分。
settings-convert-jpeg-full-chroma = JPEG 全分辨率色彩
settings-convert-jpeg-full-chroma-help = 以全分辨率 (4:4:4) 而非一半分辨率 (4:2:0) 保留色彩：色彩边缘更锐利，文件更大。
settings-convert-png-effort = PNG 压缩
settings-convert-png-effort-help = 数值越高，文件越小，但速度越慢。1 最快。
settings-convert-jxl-effort = JPEG XL 压缩力度
settings-convert-jxl-effort-help = 数值越高，文件越小，但速度越慢。
settings-convert-tiff-compression = TIFF 压缩
settings-convert-tiff-compression-help = Deflate 为无损压缩，所有 TIFF 阅读器都能读取。
settings-convert-tiff-compression-deflate = Deflate
settings-convert-tiff-compression-none = 无
settings-convert-depth = 位深度
settings-convert-depth-help = “自动”在图像超过 8 位且格式支持时 (PNG、TIFF、JPEG XL) 以每样本 16 位写入。
settings-convert-depth-auto = 自动
settings-convert-depth-8 = 8 位
settings-convert-depth-16 = 16 位
settings-convert-resize = 调整大小
settings-convert-resize-help = 图像在线性光下用高质量滤镜缩小。
settings-convert-resize-none = 原始大小
settings-convert-resize-fit = 适应范围
settings-convert-resize-long-edge = 长边
settings-convert-resize-percent = 百分比
settings-convert-width = 宽度
settings-convert-width-help = 选择“适应范围”时图像的最大宽度。
settings-convert-height = 高度
settings-convert-height-help = 选择“适应范围”时图像的最大高度。
settings-convert-long-edge = 长边
settings-convert-long-edge-help = 选择“长边”时图像较长一边的长度。
settings-convert-percent = 百分比
settings-convert-percent-help = 选择“百分比”时相对于原图的大小。
settings-convert-upscale = 放大小图像
settings-convert-upscale-help = 关闭时，已经小于目标大小的图像保持原有大小。
settings-convert-colour = 色彩
settings-convert-colour-help = “保留描述文件”会将图像的颜色描述文件一并保存。“转换为 sRGB”适合网页和没有色彩管理的设备。
settings-convert-colour-keep = 保留描述文件
settings-convert-colour-srgb = 转换为 sRGB
settings-convert-hdr = HDR 图像
settings-convert-hdr-help = PNG 和 JPEG XL 会原样保留 HDR；其他格式始终色调映射到 SDR。
settings-convert-hdr-keep = 尽可能保留
settings-convert-hdr-tone-map = 色调映射到 SDR
settings-convert-metadata = 元数据
settings-convert-metadata-help = Exif 和 XMP，例如相机、拍摄日期和位置。颜色描述文件始终保留。
settings-convert-metadata-all = 全部保留
settings-convert-metadata-no-location = 保留位置以外的全部
settings-convert-metadata-strip = 移除
settings-convert-folder = 输出文件夹
settings-convert-folder-help = 转换后文件的存放位置。未设置时，存放到每张图像旁边的子文件夹中。
settings-convert-folder-unset = 图像旁边的子文件夹
settings-convert-subfolder = 子文件夹名称
settings-convert-subfolder-help = 未设置输出文件夹时使用的子文件夹。留空：图像所在的文件夹。
settings-convert-pattern = 文件名
settings-convert-pattern-help = {"{"}name{"}"} 为原文件名，{"{"}n:03{"}"} 为批次中的序号，{"{"}date:%Y-%m-%d{"}"} 为拍摄日期，{"{"}w{"}"} 和 {"{"}h{"}"} 为新尺寸，{"{"}ext{"}"} 为格式的扩展名。
settings-convert-conflicts = 名称已被占用时
settings-convert-conflicts-help = 现有文件绝不会被替换。
settings-convert-conflicts-suffix = 添加编号
settings-convert-conflicts-skip = 跳过该图像

## The dialog
convert-title = 转换
convert-images = 图像
convert-images-current = 此图像
convert-images-selection = 选择 ({ $count })
convert-images-folder = 文件夹 ({ $count })
convert-images-picked = 精选 ({ $count })
convert-quality = 质量
convert-chroma = 色彩细节
convert-chroma-half = 4:2:0（更小）
convert-chroma-full = 4:4:4（更锐利）
convert-effort = 压缩力度
convert-on = 开
convert-off = 关
convert-pixels = { $value } 像素
convert-effort-fastest = { $value }（最快）
convert-folder-subfolder = 子文件夹“{ $name }”
convert-folder-same = 与图像相同的文件夹
convert-choose-folder = 选择文件夹…
convert-name = 名称
convert-name-preview = { $source } → { $output }
convert-name-error-unclosed = 有一个 {"{"} 未闭合。
convert-name-error-stray = 有一个 {"}"} 没有对应的 {"{"}。要输入花括号本身，请写 {"}}"}。
convert-name-error-unknown = { $token } 不是名称的组成部分。请使用 name、n、date、w、h 或 ext。
convert-name-error-format = { $token } 的格式有误。
convert-name-error-empty = 请输入名称模式。
convert-start = 转换
convert-stop = 停止
convert-hide = 隐藏
convert-close = 关闭
convert-progress = 正在转换第 { $done } 张，共 { $total } 张
convert-progress-eta = 正在转换第 { $done } 张，共 { $total } 张 · 剩余约 { $time }
convert-eta-seconds = { $count } 秒
convert-eta-minutes = { $count } 分钟
convert-done = 已转换 { $count } 张图像
convert-done-skipped = 跳过 { $count } 张：名称已被占用
convert-done-failed = { $count } 张失败
convert-stopped = 已在 { $count } 张后停止
convert-failure = { $file }：{ $reason }
convert-failure-open = 无法打开（{ $error }）
convert-failure-decode = 无法读取（{ $error }）
convert-failure-encode = 无法以此格式写入（{ $error }）
convert-failure-write = 无法保存（{ $error }）
convert-failure-same = 新文件会替换原文件
convert-report-more = 另有 { $count } 个
convert-running = 已有转换正在进行。

## Convert encoders (machine-drafted, needs native review)
settings-convert-format-avif = AVIF
settings-convert-webp-lossless = 无损 WebP
settings-convert-webp-lossless-help = 精确保留每个像素。关闭后，WebP 文件在所设 WebP 质量下会小得多。
settings-convert-webp-quality = WebP 质量
settings-convert-webp-quality-help = 数值越高，保留的细节越多，文件也越大。仅在 WebP 非无损时使用。
settings-convert-webp-effort = WebP 压缩力度
settings-convert-webp-effort-help = 数值越高，文件越小，但速度越慢。仅在 WebP 非无损时使用。
settings-convert-jxl-lossless = 无损 JPEG XL
settings-convert-jxl-lossless-help = 精确保留每个像素。关闭后，JPEG XL 文件在所设 JPEG XL 质量下会小得多。
settings-convert-jxl-quality = JPEG XL 质量
settings-convert-jxl-quality-help = 数值越高，保留的细节越多，文件也越大。90 时已很难与原图区分。仅在 JPEG XL 非无损时使用。
settings-convert-avif-quality = AVIF 质量
settings-convert-avif-quality-help = 数值越高，保留的细节越多，文件也越大。
settings-convert-avif-effort = AVIF 压缩力度
settings-convert-avif-effort-help = 数值越高，文件越小，但速度越慢。1 最快。
convert-lossless = 无损
