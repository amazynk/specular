# The Specular Discord server: the toolbar button, its Settings name, the palette and About.
# machine-drafted, needs native review

toolbar-discord = הצטרפות ל-Discord של { -app-name }
toolbar-discord-help = פתיחת שרת ה-Discord של { -app-name } בדפדפן.
settings-viewing-toolbar-items-discord = { -app-name } ב-Discord

# The other apps by the same people: About names them, and "Get …" opens an app's page in
# the browser. Pagebara, Dozed and Amazynk are names and stay as they are.
# machine-drafted, needs native review

about-more-apps = עוד מבית Amazynk
about-more-apps-pagebara = Pagebara: מציג ועורך PDF מהיר ופרטי. ל-Linux, ל-Windows ול-macOS.
about-more-apps-dozed = Dozed: מקפיא את יישומי שולחן העבודה ב-Linux שאינך מסתכל עליהם, כדי שיפסיקו להעיר את המעבד.
palette-get-pagebara = להורדת Pagebara
palette-get-pagebara-help = פתיחת הדף של Pagebara, מציג ועורך PDF, בדפדפן. ההורדות נמצאות שם.
palette-get-dozed = להורדת Dozed
palette-get-dozed-help = פתיחת הדף של Dozed, שמקפיא יישומי רקע ב-Linux, בדפדפן. ההורדות נמצאות שם.

# Settings › More from Amazynk: a row for each app, named for it, with the same button.
settings-section-amazynk = { about-more-apps }
settings-amazynk-get-zynk = Zynk
settings-amazynk-get-zynk-help = היישום Zynk הוא יישום חינמי ל-Mac, ל-Windows, ל-Linux, ל-iPhone ול-Android. הוא שולח תמונות, סרטונים ותיקיות שלמות ישירות למכשירים האחרים שלך ולאנשים אחרים, בכל גודל.
settings-amazynk-get-zynk-button = { zynk-get }
settings-amazynk-get-pagebara = Pagebara
settings-amazynk-get-pagebara-help = מציג ועורך PDF מהיר ופרטי. ל-Linux, ל-Windows ול-macOS.
settings-amazynk-get-pagebara-button = { palette-get-pagebara }
settings-amazynk-get-dozed = Dozed
settings-amazynk-get-dozed-help = מקפיא את יישומי שולחן העבודה ב-Linux שאינך מסתכל עליהם, כדי שיפסיקו להעיר את המעבד.
settings-amazynk-get-dozed-button = { palette-get-dozed }
