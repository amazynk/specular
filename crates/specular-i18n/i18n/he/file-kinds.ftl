# Specular — File kinds: which format a shared extension is, Open as…, remembered choices. עברית.

## Which kind of file? Files whose extension several formats share.

# machine-drafted, needs native review
file-kind-title = איזה סוג קובץ הוא { $file }?
# machine-drafted, needs native review
file-kind-why-content = התוכן שלו מתאים ליותר מפורמט אחד.
# machine-drafted, needs native review
file-kind-why-name = התוכן שלו לא מראה זאת. הפורמטים האלה משתמשים בקובצי .{ $ext }.
# machine-drafted, needs native review
file-kind-why-none = אף פורמט לא מזהה את התוכן שלו.
# machine-drafted, needs native review
file-kind-certain = ודאי
# machine-drafted, needs native review
file-kind-likely = סביר
# machine-drafted, needs native review
file-kind-possible = אפשרי
# machine-drafted, needs native review
file-kind-guess = לפי השם בלבד
# machine-drafted, needs native review
file-kind-hint-same = כמו קובצי .{ $ext } אחרים כאן
# machine-drafted, needs native review
file-kind-hint-companions = הקבצים הרגילים שלו נמצאים לצידו
# machine-drafted, needs native review
file-kind-scope = להשתמש בזה עבור
# machine-drafted, needs native review
file-kind-scope-file = הקובץ הזה
# machine-drafted, needs native review
file-kind-scope-folder = קובצי .{ $ext } בתיקייה הזו
# machine-drafted, needs native review
file-kind-scope-everywhere = כל קובצי ה־.{ $ext }
# machine-drafted, needs native review
file-kind-later = אפשר לשנות זאת בהמשך דרך „פתיחה בתור…” בתפריט של הקובץ.
# machine-drafted, needs native review
file-kind-open = פתיחה
# machine-drafted, needs native review
file-kind-raw = דגימות גולמיות
# machine-drafted, needs native review
file-kind-open-as-none = שום דבר אחר לא קורא את { $file }.
# machine-drafted, needs native review
error-reason-ambiguous = ייתכן שהוא אחד מכמה פורמטים. יש לבחור אחד כדי לפתוח אותו.

## Open as… (the palette and the gallery's file menu)

# machine-drafted, needs native review
palette-open-as = פתיחה בתור…
# machine-drafted, needs native review
palette-open-as-help = בחירת הפורמט שבו ייקרא הקובץ.

## Settings › Optional decoders › File kinds

# machine-drafted, needs native review
settings-decoders-file-kinds = שכחת כל סוגי הקבצים…
# machine-drafted, needs native review
settings-decoders-file-kinds-help = פורמטים שבחרת לסיומות שמשותפות לכמה פורמטים. השאלה תוצג שוב בפעם הבאה.
# machine-drafted, needs native review
file-kind-rules-intro = כל כלל פותח קבצים בעלי סיומת מסוימת בפורמט אחד.
# machine-drafted, needs native review
file-kind-rules-none = אין עדיין כללים. כשתופיע השאלה, יש לבחור „קובצי .ext בתיקייה הזו” או „כל קובצי ה־.ext”.
# machine-drafted, needs native review
file-kind-rule = קובצי .{ $ext }: { $format }
# machine-drafted, needs native review
file-kind-rule-folder = ב־{ $folder }
# machine-drafted, needs native review
file-kind-rule-everywhere = בכל מקום
# machine-drafted, needs native review
file-kind-forget = לשכוח…
# machine-drafted, needs native review
file-kind-forget-ask = לשכוח את „קובצי .{ $ext }: { $format }”?
# machine-drafted, needs native review
file-kind-forget-detail = { -app-name } ישאל שוב בפעם הבאה. אף קובץ לא משתנה ולא מוסר.
# machine-drafted, needs native review
file-kind-forget-ok = לשכוח
# machine-drafted, needs native review
file-kind-forgotten = נשכח: קובצי .{ $ext }: { $format }.
# machine-drafted, needs native review
file-kind-forget-all-ask = { $count ->
    [one] לשכוח את כלל סוג הקובץ?
    [two] לשכוח את שני כללי סוגי הקבצים?
   *[other] לשכוח את כל { $count } כללי סוגי הקבצים?
}
# machine-drafted, needs native review
file-kind-forgotten-all = { $count ->
    [one] כלל סוג הקובץ נשכח.
    [two] שני כללי סוגי הקבצים נשכחו.
   *[other] { $count } כללי סוגי קבצים נשכחו.
}
# machine-drafted, needs native review
file-kind-keywords = סיומת, פורמט, פתיחה בתור, איזה סוג, סוג קובץ

## One line on what each format is, under its name in the prompt.

# machine-drafted, needs native review
file-kind-about-other = פורמט אחר שמשתמש בקובצי .{ $ext }.
# machine-drafted, needs native review
file-kind-about-raw-volume = דגימות ללא כותרת. יש לציין רוחב, גובה, פרוסות וסוג דגימה.
# machine-drafted, needs native review
file-kind-about-raw = תמונת RAW ממצלמה.
# machine-drafted, needs native review
file-kind-about-flir-fff = תמונה תרמית של FLIR עם טמפרטורות.
# machine-drafted, needs native review
file-kind-about-fits = תמונה אסטרונומית (FITS).
# machine-drafted, needs native review
file-kind-about-fit = מסלול פעילות של Garmin: נקודות GPS ונתוני חיישנים.
# machine-drafted, needs native review
file-kind-about-mif = נפח רפואי של MRtrix (MRI).
# machine-drafted, needs native review
file-kind-about-map-info-mif = מפה וקטורית של MapInfo, עם נתוני ה־.mid שלה.
# machine-drafted, needs native review
file-kind-about-net-cdf = נתונים מדעיים ברשת (אקלים, אוקיינוס).
# machine-drafted, needs native review
file-kind-about-hdf5 = נתונים מדעיים בפורמט HDF5.
# machine-drafted, needs native review
file-kind-about-playlist = רשימת השמעה של שמע (PLS).
# machine-drafted, needs native review
file-kind-about-gerber = שכבה של מעגל מודפס (Gerber), כמו משחת הלחמה.
# machine-drafted, needs native review
file-kind-about-ser = וידאו אסטרונומי ממצלמה פלנטרית (SER).
# machine-drafted, needs native review
file-kind-about-tia = סדרה ממיקרוסקופ אלקטרונים (FEI TIA).
file-kind-about-pcd = ענן נקודות תלת־ממדי (PCD).
file-kind-about-photo-cd = סריקת Kodak Photo CD.
file-kind-about-zx-screen = תמונת מסך של ZX Spectrum.
file-kind-about-cpc-screen = תמונת מסך של Amstrad CPC.
file-kind-about-msx-screen = תמונת מסך של MSX.
file-kind-about-scc = כתוביות סגורות של Scenarist.
# machine-drafted, needs native review
file-kind-about-pict = תמונת Mac קלאסית (PICT).
# machine-drafted, needs native review
file-kind-about-hdr = תמונת HDR של Radiance.
# machine-drafted, needs native review
file-kind-about-analyze = נפח רפואי של Analyze 7.5, עם קובץ ה־.hdr שלו.
# machine-drafted, needs native review
file-kind-about-envi = רסטר של חישה מרחוק (ENVI), עם קובץ ה־.hdr שלו.
# machine-drafted, needs native review
file-kind-about-pds3 = תמונה ממשימה פלנטרית (PDS3), עם התווית שלה.
# machine-drafted, needs native review
file-kind-about-mpeg-ps = וידאו ממצלמת וידאו (זרם תוכניות MPEG, MOD/TOD).
# machine-drafted, needs native review
file-kind-about-tracker = מודול מוזיקה של Tracker (MOD, S3M, XM, IT, 669, MTM, STM, OKT, MED, ULT, FAR).
# machine-drafted, needs native review
file-kind-about-softimage-pic = רינדור תלת־ממדי של Softimage (PIC).
# machine-drafted, needs native review
file-kind-about-dr-halo = תמונת Dr. Halo, עם פלטת ה־.pal שלה.
# machine-drafted, needs native review
file-kind-about-wal = טקסטורה של Quake 2, בצבעי הפלטה של המשחק.
# machine-drafted, needs native review
file-kind-about-quick-time = סרט QuickTime.
file-kind-about-pro-res-raw = וידאו Apple ProRes RAW: פריימים מחיישן המצלמה.
file-kind-about-cinema-raw-light = וידאו Canon Cinema RAW Light: פריימים מחיישן המצלמה.
# machine-drafted, needs native review
file-kind-about-gimp-brush = מברשת GIMP.
# machine-drafted, needs native review
file-kind-about-swatch-exchange = לוח צבעים Adobe Swatch Exchange.
# machine-drafted, needs native review
file-kind-about-aseprite = ספרייט פיקסל-ארט של Aseprite.
