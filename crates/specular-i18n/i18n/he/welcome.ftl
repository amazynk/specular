welcome-tip-gallery = גלריה
welcome-tip-gallery-about = תיקייה שלמה במבט אחד.
welcome-tip-compare = השוואה
welcome-tip-compare-about = בחירת שתיים עד ארבע תמונות בגלריה כדי לראות אותן זו לצד זו.
welcome-tip-cull = מצב מיון
welcome-tip-cull-about = בחירה, דחייה ודירוג של צילומים, במקש אחד לכל פעולה.
welcome-tip-slideshow = מצגת
welcome-tip-slideshow-about = הצגת תיקייה במסך מלא, תמונה אחר תמונה.
welcome-tip-palette = לוח פקודות
welcome-tip-palette-about = חיפוש כל פקודה או הגדרה לפי שם.
welcome-tip-studies = בדיקות
welcome-tip-studies-about = המטופלים, הבדיקות והסדרות בדיסק או בתיקייה של DICOM.
welcome-tip-dicom-servers = שרתי DICOMweb
welcome-tip-dicom-servers-about = עיון בבדיקות ופתיחתן משרת PACS.
welcome-tip-dicom-tags = תגי DICOM
welcome-tip-dicom-tags-about = כל התגים של תמונה, עם חיפוש.
welcome-tip-window-level = חלון ורמה
welcome-tip-window-level-about = גרירה מכוונת את הניגודיות של תמונת DICOM.
welcome-tip-omero-servers = שרתי OMERO
welcome-tip-omero-servers-about = עיון בפרויקטים של מיקרוסקופיה ב־OMERO וב־IDR.
welcome-tip-stretch = מתיחה
welcome-tip-stretch-about = הבלטת פרטים חלשים בנתונים אסטרונומיים ומדעיים.
welcome-tip-drawing-layers = שכבות השרטוט
welcome-tip-drawing-layers-about = הצגה והסתרה של שכבות בשרטוט טכני.
welcome-tip-needs-image = יש לפתוח קודם תמונה, ואז להקיש { $key }.
welcome-tip-needs-gallery = בגלריה, יש לבחור שתיים עד ארבע תמונות ואז להקיש { $key }.
welcome-tip-key = קיצור: { $key }

## רמזים חד־פעמיים: כל אחד פעם אחת, בשקט, לכל היותר אחד בכל הפעלה. הגדרות › כללי ›
## הצגת עצות מכבה את כולם.

hint-gallery = אפשר להקיש { $key } כדי לראות את התיקייה הזו כגלריה.
hint-gallery-first = אפשר לבחור שתיים עד ארבע תמונות ולהקיש { $compare } כדי להשוות ביניהן, או { $cull } כדי למיין את התיקייה.
hint-raw = תיקייה של תמונות RAW: אפשר להקיש { $key } כדי למיין אותה (בחירה, דחייה ודירוג).
hint-pages =
    { $count ->
        [one] בקובץ הזה עמוד אחד. { $next } ו־{ $prev } מעבירים עמוד.
        [two] בקובץ הזה שני עמודים. { $next } ו־{ $prev } מעבירים עמוד.
       *[other] בקובץ הזה { $count } עמודים. { $next } ו־{ $prev } מעבירים עמוד.
    }
hint-turn-off = כיבוי העצות
hint-turned-off = העצות כובו. הגדרות › כללי › הצגת עצות מפעילה אותן מחדש.

## לוח פקודות

palette-show-welcome = הצגת מסך הפתיחה
palette-show-welcome-help = מסך הפתיחה, עם פתיחה, עיון, התמונות שלך ודברים לנסות.
palette-close = סגירה
palette-close-help = סגירת התמונה או התיקייה וחזרה למסך הפתיחה. במסך הפתיחה: יציאה.

