welcome-title = { -app-name }
welcome-tagline = מציג מהיר ונאמן לתמונות ולתמונות טכניות, מדעיות ורפואיות.
welcome-open = פתיחת קובץ…
welcome-open-about = תמונה, מסמך או קובץ נתונים.
welcome-browse = עיון בתיקייה…
welcome-browse-about = בחירת תיקייה והצגתה כגלריה.
welcome-pictures = התמונות שלך
welcome-pictures-about = כל התמונות בספרייה שלך, לפי תאריך ומקום.
welcome-pictures-setup-title = הגדרת הספרייה…
welcome-pictures-setup = החל מהתיקייה { $folder }.
welcome-pictures-ask = להוסיף את התיקייה { $folder } לספרייה?
welcome-pictures-add = הוספת תיקייה
welcome-drop = אפשר גם לגרור קבצים או תיקיות לכל מקום בחלון הזה.
welcome-recent = תיקיות אחרונות
welcome-recent-name = { $name }, בתוך { $parent }
welcome-tips = כדאי לנסות
welcome-tips-hide = הסתרת העצות האלה
welcome-tips-hidden = העצות הוסתרו. „הצגת מסך הפתיחה” בלוח הפקודות מחזירה אותן.

