page-label-z = Z { $index } מתוך { $count }
page-label-t = T { $index } מתוך { $count }
# machine-drafted, needs native review
# Views of a remote-sensing product (an ENVI cube, a Sentinel-2 product) in the page picker.
page-label-product-composite = ערוצי ברירת המחדל
page-label-product-bands = כל הערוצים
page-label-product-true-colour = צבע אמיתי
page-label-product-false-colour = צבע מדומה (אינפרה־אדום קרוב)
page-label-product-swir = אינפרה־אדום גל קצר
page-label-product-agriculture = חקלאות
page-label-product-scene-class = סיווג סצנה
page-label-product-cloud = הסתברות לעננות
# A product view at a pixel size, e.g. "True colour, 10 m".
page-label-product-at = { $view }, { $metres } מ׳
title-file-page = { $file } — { $page }
info-page-group = עמוד
info-page-position = מיקום
info-page-contents = תוכן

# machine-drafted, needs native review
