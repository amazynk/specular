# הפעלת הנפשות ומצב קריאה (ארכיונים, קומיקס).

disabled-not-animated = התמונה הזאת אינה מונפשת
disabled-in-archive = אי אפשר להעביר לאשפה דפים שבתוך ארכיון

## לוח הפקודות ורשימת הקיצורים

palette-play-pause = הפעלה או השהיה של ההנפשה
palette-next-frame = המסגרת הבאה
palette-prev-frame = המסגרת הקודמת
palette-faster = הפעלה מהירה יותר
palette-slower = הפעלה איטית יותר
palette-normal-speed = מהירות הפעלה רגילה
palette-loop-forever = חזרה על ההנפשה בלי סוף
palette-right-to-left = סדר עמודים מימין לשמאל
# machine-drafted, needs native review
palette-contents = תוכן עניינים
palette-spreads = עמודים כפולים

## פקדי ההנפשה

transport-region = פקדי ההנפשה
transport-play = הפעלה
transport-pause = השהיה
transport-prev-frame = המסגרת הקודמת
transport-next-frame = המסגרת הבאה
transport-slower = לאט יותר
transport-faster = מהר יותר
transport-frame = מסגרת { $index } / { $count }
transport-frame-unknown = מסגרת { $index }
transport-speed = { $speed }×
transport-speed-name = מהירות הפעלה { $speed }×
# machine-drafted, needs native review
motion-badge = תנועה
motion-badge-live = Live
motion-play = הפעלת קטע התנועה
motion-play-live = הפעלת ה־Live Photo
motion-stop = חזרה לתמונה הסטטית
toast-motion-failed = לא ניתן להפעיל את קטע התנועה: { $reason }

## הודעות

toast-speed = מהירות הפעלה { $speed }×
toast-loop-forever-on = חזרה בלי סוף
toast-loop-forever-off = חזרה לפי הקובץ
toast-right-to-left-on = העמודים נקראים מימין לשמאל
toast-right-to-left-off = העמודים נקראים משמאל לימין
toast-spreads-on = עמודים כפולים
toast-spreads-off = עמוד אחד בכל פעם

## ארכיונים

title-archive-page = { $page } — { $archive }
readout-position-spread = { $first }–{ $last } / { $count }
archive-needs-sandbox = ארכיוני { $format } נפתחים רק במפענח המבודד, שעדיין אינו כלול בגרסה הזאת.
archive-empty = אין תמונות בארכיון הזה.
archive-failed = לא ניתן לפתוח את הארכיון: { $error }
archive-encrypted = הארכיון הזה מוצפן. יש לפתוח אותו שוב כדי להזין את הסיסמה.
archive-wrong-password = הסיסמה לארכיון הזה שגויה.
password-title = נדרשת סיסמה
password-archive = הארכיון „{ $archive }” מוצפן.
password-label = סיסמה
password-show = הצגת הסיסמה
password-wrong = סיסמה שגויה. יש לנסות שוב.
password-open = פתיחה
password-cancel = ביטול

## הגדרות

settings-viewing-animation-autoplay = הפעלה אוטומטית של הנפשות
settings-viewing-animation-autoplay-help = להתחיל תמונות מונפשות (GIF‏, APNG‏, WebP…) מיד כשהן נפתחות.
settings-viewing-animation-loop = חזרה על הנפשות
settings-viewing-animation-loop-help = כמה פעמים הנפשות חוזרות.
settings-viewing-animation-loop-file = לפי הקובץ
settings-viewing-animation-loop-forever = בלי סוף
settings-viewing-animation-loop-once = פעם אחת
settings-viewing-animation-short-delays = השהיות מסגרת קצרות מאוד
settings-viewing-animation-short-delays-help = מסגרות של 10 אלפיות שנייה או פחות: להאט אותן ל־100 אלפיות שנייה כמו דפדפני אינטרנט, או להפעיל אותן כפי שנשמרו.
settings-viewing-animation-short-delays-browser = כמו דפדפני אינטרנט (100 אלפיות שנייה)
settings-viewing-animation-short-delays-as-stored = כפי שנשמרו
settings-browsing-reading-order = סדר העמודים בארכיונים
settings-browsing-reading-order-help = ארכיוני קומיקס נקראים מימין לשמאל כש־ComicInfo.xml שלהם מציין זאת (מנגה), אלא אם נקבע אחרת כאן.
settings-browsing-reading-order-auto = לפי הארכיון
settings-browsing-reading-order-left-to-right = משמאל לימין
settings-browsing-reading-order-right-to-left = מימין לשמאל
settings-browsing-page-layout = עמודים בארכיונים
settings-browsing-page-layout-help = להציג עמוד אחד או שניים זה לצד זה; הכריכה מוצגת תמיד לבדה.
settings-browsing-page-layout-auto = לפי הארכיון
settings-browsing-page-layout-single = עמוד אחד
settings-browsing-page-layout-spreads = עמודים כפולים

## Pages of multi-image files (ICNS sizes, texture layers, faces and slices, TIFF pages) (machine-drafted, needs native review)
palette-next-page = העמוד הבא
palette-prev-page = העמוד הקודם
palette-first-page = העמוד הראשון
palette-last-page = העמוד האחרון
disabled-one-page = לתמונה יש עמוד אחד בלבד
page-indicator = עמוד { $index } מתוך { $count }
page-indicator-labelled = { $page }, { $label }
page-label-icon = { $width }×{ $height }
page-label-icon-density = { $width }×{ $height } @{ $density }x
page-label-layer = שכבה { $index }
page-label-face = פאה { $face }
page-label-sphere = מפה כדורית
page-label-slice = פרוסה { $index }
page-label-join = { $a } · { $b }
