# machine-drafted, needs native review
# Vet, orthopaedic and cephalometric geometry in the measuring tool. Every point is placed
# by hand; nothing is detected or graded.

measure-tool-geometry = גאומטריה
measure-tool-hint-geometry = יש לבחור תבנית ולמקם כל נקודה שהיא מבקשת.
measure-tool-template = תבנית: { $name }

geometry-prompt = { $template }, נקודה { $n } מתוך { $total }: { $point }
geometry-readout = { $name }: { $value }
geometry-value-angle = { $value }°
geometry-value-vertebrae = { $value } חוליות
geometry-extrapolated = { $value } (מעבר ל-T9, הערכה)
geometry-degenerate = הנקודות קרובות מדי או על קו אחד. יש להזיז נקודה.
geometry-moved = הנקודה הוזזה. { $value }
# machine-drafted, needs native review
geometry-picked = הנקודה { $point } הורמה. מקשי החיצים מזיזים אותה, Shift בצעדים גדולים יותר. רווח מניח אותה, Esc מחזיר אותה למקומה.
geometry-put-back = הנקודה הוחזרה למקומה.

# Templates.
geometry-vhs = ציון לב חולייתי (VHS)
geometry-vlas = גודל עלייה שמאלית חולייתי (VLAS)
geometry-norberg = זווית נורברג
geometry-tpa = זווית רמת השוקה (TPA)
geometry-distraction-index = אינדקס דיסטרקציה
geometry-femoral-head = מעגל ראש הירך
geometry-femoral-offset = אופסט ירכי
geometry-leg-length = אורך רגל
geometry-acetabular-angle = זווית האצטבולום (Sharp)
geometry-steiner = ניתוח שטיינר
geometry-downs = ניתוח דאונס

# Points, in the order they are asked for.
geometry-pt-long-axis-carina = ציר ארוך, הצד הגחוני של הקרינה
geometry-pt-long-axis-apex = ציר ארוך, קודקוד הלב
geometry-pt-short-axis = ציר קצר, קצה { $n }
geometry-pt-t4-cranial = הקצה הקרניאלי של T4
geometry-pt-vertebra-caudal = הקצה הקאודלי של T{ $n }
geometry-pt-vlas-carina = הצד הגחוני של הקרינה
geometry-pt-vlas-atrium = העלייה השמאלית בווריד הנבוב הקאודלי
geometry-pt-left-head-rim = ראש הירך השמאלי, נקודת שפה { $n } מתוך 3
geometry-pt-right-head-rim = ראש הירך הימני, נקודת שפה { $n } מתוך 3
geometry-pt-left-acetabular-rim = שפת האצטבולום הקרניו-לטרלית השמאלית
geometry-pt-right-acetabular-rim = שפת האצטבולום הקרניו-לטרלית הימנית
geometry-pt-eminence = מרכז הבליטות הבין-קונדיליות
geometry-pt-talus = מרכז הטלוס
geometry-pt-plateau-cranial = הקצה הקרניאלי של רמת השוקה המדיאלית
geometry-pt-plateau-caudal = הקצה הקאודלי של רמת השוקה המדיאלית
geometry-pt-head-rim = ראש הירך, נקודת שפה { $n } מתוך 3
geometry-pt-acetabulum-rim = אצטבולום, נקודת שפה { $n } מתוך 3
geometry-pt-shaft-proximal = ציר גוף עצם הירך, נקודה עליונה
geometry-pt-shaft-distal = ציר גוף עצם הירך, נקודה תחתונה
geometry-pt-reference = קו ייחוס אגני, נקודה { $n }
geometry-pt-left-landmark = ציון דרך ברגל שמאל
geometry-pt-right-landmark = ציון דרך ברגל ימין
geometry-pt-teardrop = טיפת הדמעה, צד זה
geometry-pt-teardrop-other = טיפת הדמעה, הצד השני
geometry-pt-acetabular-edge = השפה הלטרלית של האצטבולום
geometry-pt-s = סלה (S)
geometry-pt-n = נזיון (N)
geometry-pt-a = נקודה A
geometry-pt-b = נקודה B
geometry-pt-pog = פוגוניון (Pog)
geometry-pt-go = גוניון (Go)
geometry-pt-gn = גנתיון (Gn)
geometry-pt-me = מנטון (Me)
geometry-pt-po = פוריון (Po)
geometry-pt-or = אורביטלה (Or)
geometry-pt-u1-tip = קצה החותכת העליונה
geometry-pt-u1-apex = אפקס החותכת העליונה
geometry-pt-l1-tip = קצה החותכת התחתונה
geometry-pt-l1-apex = אפקס החותכת התחתונה
geometry-pt-occlusal-front = מישור הסגר, נקודה קדמית
geometry-pt-occlusal-back = מישור הסגר, נקודה אחורית

