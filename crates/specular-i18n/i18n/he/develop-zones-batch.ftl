develop-tone-zones = אזורי טון
develop-tone-zone = { $ev } EV
develop-tone-zones-adjust = כוונון אזורים על התמונה
develop-tone-zones-done = סיום כוונון אזורים
develop-tone-zones-adjusting = יש לגרור למעלה או למטה על התמונה כדי להעלות או להוריד את הטון. Esc מסיים.
develop-tone-zone-picked = אזור { $zone }
develop-batch-conflict-title = { $count ->
    [one] תמונה אחת השתנתה מחוץ ל־Specular
    [two] שתי תמונות השתנו מחוץ ל־Specular
   *[other] { $count } תמונות השתנו מחוץ ל־Specular
}
develop-batch-conflict-detail = קובצי הלוואי שלהן חדשים יותר מהעותקים בספרייה.
develop-batch-conflict-keep = שמירה: ההדבקה מונחת מעל השינויים שבקובץ.
develop-batch-conflict-replace = החלפה: ההדבקה מונחת על העותק שבספרייה. השינויים שבקובץ אובדים.
develop-batch-conflict-skip-detail = דילוג: התמונות האלה נשארות כמו שהן.
develop-batch-conflict-file = שמירת השינויים שבקובץ
develop-batch-conflict-library = החלפתם
develop-batch-conflict-skip = דילוג על התמונות האלה
develop-pair-raw = מפותח { $file }, קובץ ה־RAW של הזוג
develop-source-cmyk = תמונת CMYK זו נערכת ב־RGB. היא הומרה בעזרת הפרופיל שלה.
