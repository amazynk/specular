## סרגל הבקרה

# ‏$position ו־$duration הם זמנים כמו 0:12 ו־1:30:05.
transport-time = { $position } / { $duration }
# פס המיקום בראש הסרגל (שם נגישות ותיאור כלי).
transport-seek-bar = מיקום בסרט
transport-loop-on = הפעלת הסרט בלולאה
transport-loop-off = הפסקת הלולאה
transport-mute = השתקה
transport-unmute = ביטול השתקה
transport-volume = עוצמת קול

## הודעות

# ‏$percent הוא מספר שלם, למשל 80.
toast-volume = עוצמת קול { PERCENT($percent) }
toast-muted = הצליל מושתק
toast-unmuted = הצליל פועל
toast-video-loop-on = הסרט בלולאה
toast-video-loop-off = הסרט מופעל פעם אחת
# מוצג פעם אחת לכל סרט כשאין התקן שמע או שהוא נעלם; הסרט ממשיך.
toast-no-sound-device = אין התקן שמע: הפעלה ללא צליל
toast-sound-device-lost = התקן השמע נעלם: הפעלה ללא צליל
# הצליל מקודד בקידוד שגרסה זו אינה יכולה להפעיל; ‏$codec הוא שמו, למשל AAC.
toast-sound-unsupported = הפעלה ללא צליל: עדיין אין אפשרות להפעיל צליל { $codec }
# machine-drafted, needs native review
# The movie's sound decoder stopped part way; $reason is error-reason-internal.
toast-sound-stopped = הצליל נעצר: { $reason }

