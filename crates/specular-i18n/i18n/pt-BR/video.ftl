transport-loop-on = Repetir o filme
transport-loop-off = Parar de repetir
transport-mute = Silenciar
transport-unmute = Ativar som
transport-volume = Volume

## Avisos

# $percent é um número inteiro, ex. 80.
toast-volume = Volume { PERCENT($percent) }
toast-muted = Som silenciado
toast-unmuted = Som ativado
toast-video-loop-on = Repetindo o filme
toast-video-loop-off = Reproduzindo o filme uma vez
# Mostrado uma vez por filme quando não há dispositivo de som ou ele some; o filme continua.
toast-no-sound-device = Nenhum dispositivo de som: reproduzindo sem som
toast-sound-device-lost = O dispositivo de som sumiu: reproduzindo sem som
# O som usa uma codificação que esta versão não reproduz; $codec a nomeia, ex. AAC.
toast-sound-unsupported = Reproduzindo sem som: som { $codec } ainda não é suportado
# machine-drafted, needs native review
# The movie's sound decoder stopped part way; $reason is error-reason-internal.
toast-sound-stopped = O som parou: { $reason }

