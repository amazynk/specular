# The system menu bar on macOS: the titles of the Edit and Go menus, and the items the
# system carries out itself (the application menu's Services, Hide and Show All; the Window
# menu's). They follow the wording of macOS in each language. The other items are the
# actions, under the names the palette gives them.
# machine-drafted, needs native review

menu-edit = Редагування
menu-go = Перехід
menu-services = Служби
menu-hide = Сховати { -app-name }
menu-hide-others = Сховати решту
menu-show-all = Показати всі
menu-minimise = Згорнути
menu-zoom = Змінити розмір
menu-bring-all-to-front = Усе на передній план
