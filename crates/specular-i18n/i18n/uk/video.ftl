## Панель керування

# $position і $duration — час, як-от 0:12 і 1:30:05.
transport-time = { $position } / { $duration }
# Смуга позиції вгорі панелі (назва для спеціальних можливостей і підказка).
transport-seek-bar = Позиція у фільмі
transport-loop-on = Повторювати фільм
transport-loop-off = Не повторювати
transport-mute = Вимкнути звук
transport-unmute = Увімкнути звук
transport-volume = Гучність

## Сповіщення

# $percent — ціле число, напр. 80.
toast-volume = Гучність { PERCENT($percent) }
toast-muted = Звук вимкнено
toast-unmuted = Звук увімкнено
toast-video-loop-on = Фільм повторюється
toast-video-loop-off = Фільм відтворюється один раз
# Показується раз на фільм, коли немає звукового пристрою або він зник; фільм грає далі.
toast-no-sound-device = Немає звукового пристрою: відтворення без звуку
toast-sound-device-lost = Звуковий пристрій зник: відтворення без звуку
# Звук закодовано так, що ця версія не може його відтворити; $codec називає кодування, напр. AAC.
toast-sound-unsupported = Відтворення без звуку: звук { $codec } поки не підтримується
# machine-drafted, needs native review
# The movie's sound decoder stopped part way; $reason is error-reason-internal.
toast-sound-stopped = Звук зупинився: { $reason }

