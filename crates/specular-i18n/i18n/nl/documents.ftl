# machine-drafted, needs native review

## Books (EPUB): the table of contents panel (Alt+T).

contents-title = Inhoud
# Toast when Alt+T is pressed over a file without a table of contents.
contents-none = Dit bestand heeft geen inhoudsopgave.

## Fonts: the specimen page (TTF, OTF, TTC/OTC, WOFF, WOFF2).

# The specimen's accessible name.
font-specimen = Letterproef van { $family }
# Shown when the font names no family.
font-unnamed = Naamloos lettertype
font-designer = Ontwerper: { $value }
font-foundry = Lettergieterij: { $value }
font-licence = Licentie: { $value }
font-licence-url = Licentie-URL: { $value }
# A sentence using every letter of the alphabet, shown at several sizes in the font. Use one
# for the language (translators: any common pangram of your language).
font-pangram = Pa's wijze lynx bezag vroom het fikse aquaduct. 0123456789
# Heading of the glyph grid: "Glyphs 1–256 of 1,024".
font-glyphs-range = Glyphs { $first }–{ $last } van { $count }
font-glyphs-none = Geen glyphs
font-glyphs-previous = Vorige glyphs
font-glyphs-next = Volgende glyphs
# The row of colour glyphs drawn in colour.
font-colour-row = Kleurglyphs
font-note-colr0 = Kleurglyphs worden in kleur getekend in de rij hieronder; de tekst erboven is in één kleur.
font-note-colr1 = Glyphs van COLR-versie 1 (verlopen) worden in één kleur getekend: de tekstweergave tekent alleen lagen van COLR-versie 0 in kleur.
font-note-bitmaps = Bitmap-kleurglyphs worden in kleur getekend in de rij hieronder; de tekst erboven is in één kleur.
font-note-svg = SVG-kleurglyphs worden in één kleur getekend: de tekstweergave leest geen SVG-glyphs.
font-note-no-glyphs = Dit lettertype heeft geen contouren of bitmaps om te tekenen.
font-note-bitmap-only = Dit lettertype heeft alleen zwart-witbitmaps, die de tekstweergave niet tekent.
