# machine-drafted, needs native review
# Vet, orthopaedic and cephalometric geometry in the measuring tool. Every point is placed
# by hand; nothing is detected or graded.

measure-tool-geometry = Geometrie
measure-tool-hint-geometry = Kies een sjabloon en plaats dan elk punt dat het vraagt.
measure-tool-template = Sjabloon: { $name }

geometry-prompt = { $template }, punt { $n } van { $total }: { $point }
geometry-readout = { $name }: { $value }
geometry-value-angle = { $value }°
geometry-value-vertebrae = { $value } v
geometry-extrapolated = { $value } (voorbij T9, geschat)
geometry-degenerate = Punten te dicht bij elkaar of op één lijn. Verplaats een punt.
geometry-moved = Punt verplaatst. { $value }
# machine-drafted, needs native review
geometry-picked = Punt { $point } opgepakt. Pijltjes verplaatsen het, met Shift in grotere stappen. Spatie zet het neer, Esc zet het terug.
geometry-put-back = Punt teruggezet.

# Templates.
geometry-vhs = Vertebrale hartscore (VHS)
