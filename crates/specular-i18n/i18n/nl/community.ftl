settings-amazynk-get-zynk-button = { zynk-get }
settings-amazynk-get-pagebara = Pagebara
settings-amazynk-get-pagebara-help = Een snelle, private pdf-viewer en -editor. Voor Linux, Windows en macOS.
settings-amazynk-get-pagebara-button = { palette-get-pagebara }
settings-amazynk-get-dozed = Dozed
settings-amazynk-get-dozed-help = Bevriest de Linux-desktopapps waar je niet naar kijkt, zodat ze de CPU niet meer wekken.
