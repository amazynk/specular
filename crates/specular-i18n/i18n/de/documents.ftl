# machine-drafted, needs native review

## Books (EPUB): the table of contents panel (Alt+T).

contents-title = Inhalt
# Toast when Alt+T is pressed over a file without a table of contents.
contents-none = Diese Datei hat kein Inhaltsverzeichnis.

## Fonts: the specimen page (TTF, OTF, TTC/OTC, WOFF, WOFF2).

# The specimen's accessible name.
font-specimen = Schriftmuster von { $family }
# Shown when the font names no family.
font-unnamed = Unbenannte Schrift
font-designer = Gestaltung: { $value }
font-foundry = Schriftgießerei: { $value }
font-licence = Lizenz: { $value }
font-licence-url = Lizenz-URL: { $value }
# A sentence using every letter of the alphabet, shown at several sizes in the font. Use one
# for the language (translators: any common pangram of your language).
font-pangram = Victor jagt zwölf Boxkämpfer quer über den großen Sylter Deich. 0123456789
# Heading of the glyph grid: "Glyphs 1–256 of 1,024".
font-glyphs-range = Glyphen { $first }–{ $last } von { $count }
font-glyphs-none = Keine Glyphen
font-glyphs-previous = Vorherige Glyphen
font-glyphs-next = Nächste Glyphen
# The row of colour glyphs drawn in colour.
font-colour-row = Farbglyphen
font-note-colr0 = Farbglyphen werden in der Zeile darunter farbig gezeichnet; der Text darüber ist einfarbig.
font-note-colr1 = Glyphen nach COLR Version 1 (Verläufe) werden einfarbig gezeichnet: Die Textdarstellung zeichnet nur Ebenen nach COLR Version 0 farbig.
font-note-bitmaps = Bitmap-Farbglyphen werden in der Zeile darunter farbig gezeichnet; der Text darüber ist einfarbig.
font-note-svg = SVG-Farbglyphen werden einfarbig gezeichnet: Die Textdarstellung liest keine SVG-Glyphen.
font-note-no-glyphs = Diese Schrift hat keine Konturen oder Bitmaps zum Zeichnen.
font-note-bitmap-only = Diese Schrift hat nur Schwarz-Weiß-Bitmaps, die die Textdarstellung nicht zeichnet.
