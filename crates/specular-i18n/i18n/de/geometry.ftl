geometry-pt-vlas-carina = ventrale Carina
geometry-pt-vlas-atrium = linkes Atrium an der Vena cava caudalis
geometry-pt-left-head-rim = linker Femurkopf, Randpunkt { $n } von 3
geometry-pt-right-head-rim = rechter Femurkopf, Randpunkt { $n } von 3
geometry-pt-left-acetabular-rim = linker kraniolateraler Acetabulumrand
