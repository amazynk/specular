# machine-drafted, needs native review
# Vet, orthopaedic and cephalometric geometry in the measuring tool. Every point is placed
# by hand; nothing is detected or graded.

measure-tool-geometry = Geometrie
measure-tool-hint-geometry = Vorlage wählen, dann jeden abgefragten Punkt setzen.
measure-tool-template = Vorlage: { $name }

geometry-prompt = { $template }, Punkt { $n } von { $total }: { $point }
geometry-readout = { $name }: { $value }
geometry-value-angle = { $value }°
geometry-value-vertebrae = { $value } v
geometry-extrapolated = { $value } (über T9 hinaus, geschätzt)
geometry-degenerate = Punkte zu nah beieinander oder auf einer Linie. Einen Punkt verschieben.
geometry-moved = Punkt verschoben. { $value }
# machine-drafted, needs native review
geometry-picked = Punkt { $point } aufgenommen. Pfeiltasten verschieben ihn, mit Shift in größeren Schritten. Leertaste setzt ihn ab, Esc setzt ihn zurück.
geometry-put-back = Punkt zurückgesetzt.

# Templates.
geometry-vhs = Vertebral Heart Score (VHS)
geometry-vlas = Vertebrale linksatriale Größe (VLAS)
geometry-norberg = Norberg-Winkel
geometry-tpa = Tibiaplateauwinkel (TPA)
geometry-distraction-index = Distraktionsindex
geometry-femoral-head = Femurkopfkreis
geometry-femoral-offset = Femorales Offset
geometry-leg-length = Beinlänge
geometry-acetabular-angle = Pfannendachwinkel (Sharp)
geometry-steiner = Steiner-Analyse
geometry-downs = Downs-Analyse

