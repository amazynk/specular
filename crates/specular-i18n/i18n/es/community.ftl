# The Specular Discord server: the toolbar button, its Settings name, the palette and About.
# machine-drafted, needs native review

toolbar-discord = Unirse al Discord de { -app-name }
toolbar-discord-help = Abrir el servidor de Discord de { -app-name } en el navegador.
settings-viewing-toolbar-items-discord = { -app-name } en Discord

# The other apps by the same people: About names them, and "Get …" opens an app's page in
# the browser. Pagebara, Dozed and Amazynk are names and stay as they are.
# machine-drafted, needs native review

about-more-apps = Más de Amazynk
about-more-apps-pagebara = Pagebara: un visor y editor de PDF rápido y privado. Para Linux, Windows y macOS.
about-more-apps-dozed = Dozed: congela las aplicaciones de escritorio de Linux que no estás mirando para que dejen de despertar la CPU.
palette-get-pagebara = Obtener Pagebara
palette-get-pagebara-help = Abrir en el navegador la página de Pagebara, un visor y editor de PDF. Allí están las descargas.
palette-get-dozed = Obtener Dozed
palette-get-dozed-help = Abrir en el navegador la página de Dozed, que congela las aplicaciones en segundo plano en Linux. Allí están las descargas.

# Settings › More from Amazynk: a row for each app, named for it, with the same button.
settings-section-amazynk = { about-more-apps }
settings-amazynk-get-zynk = Zynk
settings-amazynk-get-zynk-help = Zynk es una app gratuita para Mac, Windows, Linux, iPhone y Android. Envía fotos, vídeos y carpetas enteras directamente a tus otros dispositivos y a otras personas, del tamaño que sean.
settings-amazynk-get-zynk-button = { zynk-get }
settings-amazynk-get-pagebara = Pagebara
settings-amazynk-get-pagebara-help = Un visor y editor de PDF rápido y privado. Para Linux, Windows y macOS.
settings-amazynk-get-pagebara-button = { palette-get-pagebara }
settings-amazynk-get-dozed = Dozed
settings-amazynk-get-dozed-help = Congela las aplicaciones de escritorio de Linux que no estás mirando para que dejen de despertar la CPU.
settings-amazynk-get-dozed-button = { palette-get-dozed }
