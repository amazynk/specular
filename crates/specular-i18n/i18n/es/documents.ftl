# machine-drafted, needs native review

## Books (EPUB): the table of contents panel (Alt+T).

contents-title = Índice
# Toast when Alt+T is pressed over a file without a table of contents.
contents-none = Este archivo no tiene índice.

## Fonts: the specimen page (TTF, OTF, TTC/OTC, WOFF, WOFF2).

# The specimen's accessible name.
font-specimen = Muestra de { $family }
# Shown when the font names no family.
font-unnamed = Fuente sin nombre
font-designer = Diseño: { $value }
font-foundry = Fundición: { $value }
font-licence = Licencia: { $value }
font-licence-url = URL de la licencia: { $value }
# A sentence using every letter of the alphabet, shown at several sizes in the font. Use one
# for the language (translators: any common pangram of your language).
font-pangram = El veloz murciélago hindú comía feliz cardillo y kiwi. 0123456789
# Heading of the glyph grid: "Glyphs 1–256 of 1,024".
font-glyphs-range = Glifos { $first }–{ $last } de { $count }
font-glyphs-none = Sin glifos
font-glyphs-previous = Glifos anteriores
font-glyphs-next = Glifos siguientes
# The row of colour glyphs drawn in colour.
font-colour-row = Glifos en color
font-note-colr0 = Los glifos en color se dibujan en color en la fila de abajo; el texto de arriba va en un solo color.
font-note-colr1 = Los glifos COLR versión 1 (degradados) se dibujan en un solo color: el motor de texto solo dibuja en color las capas COLR versión 0.
font-note-bitmaps = Los glifos de mapa de bits en color se dibujan en color en la fila de abajo; el texto de arriba va en un solo color.
font-note-svg = Los glifos SVG en color se dibujan en un solo color: el motor de texto no lee glifos SVG.
font-note-no-glyphs = Esta fuente no tiene contornos ni mapas de bits que dibujar.
font-note-bitmap-only = Esta fuente solo tiene mapas de bits en blanco y negro, que el motor de texto no dibuja.
