transport-loop-on = Repetir la película
transport-loop-off = Dejar de repetir
transport-mute = Silenciar
transport-unmute = Activar sonido
transport-volume = Volumen

## Avisos

# $percent es un número entero, p. ej. 80.
toast-volume = Volumen { PERCENT($percent) }
toast-muted = Sonido silenciado
toast-unmuted = Sonido activado
toast-video-loop-on = Repitiendo la película
toast-video-loop-off = Reproduciendo la película una vez
# Se muestra una vez por película si no hay dispositivo de sonido o desaparece; la película sigue.
toast-no-sound-device = No hay dispositivo de sonido: se reproduce sin sonido
toast-sound-device-lost = El dispositivo de sonido ha desaparecido: se reproduce sin sonido
# El sonido usa una codificación que esta versión no puede reproducir; $codec la nombra, p. ej. AAC.
toast-sound-unsupported = Se reproduce sin sonido: aún no se puede reproducir sonido { $codec }
# machine-drafted, needs native review
# The movie's sound decoder stopped part way; $reason is error-reason-internal.
toast-sound-stopped = El sonido se ha detenido: { $reason }

