# machine-drafted, needs native review
# Vet, orthopaedic and cephalometric geometry in the measuring tool. Every point is placed
# by hand; nothing is detected or graded.

measure-tool-geometry = Geometría
measure-tool-hint-geometry = Elija una plantilla y coloque cada punto que le pida.
measure-tool-template = Plantilla: { $name }

geometry-prompt = { $template }, punto { $n } de { $total }: { $point }
geometry-readout = { $name }: { $value }
geometry-value-angle = { $value }°
geometry-value-vertebrae = { $value } v
geometry-extrapolated = { $value } (más allá de T9, estimado)
geometry-degenerate = Puntos demasiado cercanos o alineados. Mueva un punto.
geometry-moved = Punto movido. { $value }
# machine-drafted, needs native review
geometry-picked = Punto { $point } recogido. Las flechas lo mueven; con Shift, en pasos mayores. Espacio lo suelta, Esc lo devuelve a su sitio.
geometry-put-back = Punto devuelto a su sitio.

# Templates.
geometry-vhs = Escala vertebral cardíaca (VHS)
geometry-vlas = Tamaño vertebral de la aurícula izquierda (VLAS)
geometry-norberg = Ángulo de Norberg
geometry-tpa = Ángulo de la meseta tibial (TPA)
geometry-distraction-index = Índice de distracción
