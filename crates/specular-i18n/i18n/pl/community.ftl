# The Specular Discord server: the toolbar button, its Settings name, the palette and About.
# machine-drafted, needs native review

toolbar-discord = Dołącz do Discorda { -app-name }
toolbar-discord-help = Otwórz serwer { -app-name } na Discordzie w przeglądarce.
settings-viewing-toolbar-items-discord = { -app-name } na Discordzie

# The other apps by the same people: About names them, and "Get …" opens an app's page in
# the browser. Pagebara, Dozed and Amazynk are names and stay as they are.
# machine-drafted, needs native review

about-more-apps = Więcej od Amazynk
about-more-apps-pagebara = Pagebara: szybka, prywatna przeglądarka i edytor PDF. Dla systemów Linux, Windows i macOS.
about-more-apps-dozed = Dozed: zamraża aplikacje pulpitu w Linuksie, na które nie patrzysz, aby przestały wybudzać procesor.
palette-get-pagebara = Pobierz Pagebara
palette-get-pagebara-help = Otwórz w przeglądarce stronę aplikacji Pagebara, przeglądarki i edytora PDF. Tam są pliki do pobrania.
palette-get-dozed = Pobierz Dozed
palette-get-dozed-help = Otwórz w przeglądarce stronę aplikacji Dozed, która zamraża aplikacje w tle w Linuksie. Tam są pliki do pobrania.

# Settings › More from Amazynk: a row for each app, named for it, with the same button.
settings-section-amazynk = { about-more-apps }
settings-amazynk-get-zynk = Zynk
settings-amazynk-get-zynk-help = Zynk to darmowa aplikacja na Maca, Windows, Linuksa, iPhone’a i Androida. Wysyła zdjęcia, filmy i całe foldery prosto na twoje inne urządzenia i do innych osób, bez względu na rozmiar.
settings-amazynk-get-zynk-button = { zynk-get }
settings-amazynk-get-pagebara = Pagebara
settings-amazynk-get-pagebara-help = Szybka, prywatna przeglądarka i edytor PDF. Dla systemów Linux, Windows i macOS.
settings-amazynk-get-pagebara-button = { palette-get-pagebara }
settings-amazynk-get-dozed = Dozed
settings-amazynk-get-dozed-help = Zamraża aplikacje pulpitu w Linuksie, na które nie patrzysz, aby przestały wybudzać procesor.
settings-amazynk-get-dozed-button = { palette-get-dozed }
