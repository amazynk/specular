# machine-drafted, needs native review
# Vet, orthopaedic and cephalometric geometry in the measuring tool. Every point is placed
# by hand; nothing is detected or graded.

measure-tool-geometry = Geometria
measure-tool-hint-geometry = Wybierz szablon, a potem umieść każdy punkt, o który prosi.
measure-tool-template = Szablon: { $name }

geometry-prompt = { $template }, punkt { $n } z { $total }: { $point }
geometry-readout = { $name }: { $value }
geometry-value-angle = { $value }°
geometry-value-vertebrae = { $value } v
geometry-extrapolated = { $value } (poza T9, szacunkowo)
geometry-degenerate = Punkty są zbyt blisko lub na jednej linii. Przesuń punkt.
geometry-moved = Punkt przesunięty. { $value }
# machine-drafted, needs native review
geometry-picked = Podniesiono punkt { $point }. Strzałki go przesuwają, z Shift większymi krokami. Spacja go odkłada, Esc przywraca go na miejsce.
geometry-put-back = Punkt przywrócony na miejsce.

# Templates.
geometry-vhs = Kręgowy wskaźnik serca (VHS)
geometry-vlas = Kręgowy wskaźnik lewego przedsionka (VLAS)
geometry-norberg = Kąt Norberga
geometry-tpa = Kąt plateau kości piszczelowej (TPA)
geometry-distraction-index = Wskaźnik dystrakcji
geometry-femoral-head = Okrąg głowy kości udowej
geometry-femoral-offset = Offset udowy
geometry-leg-length = Długość kończyn
geometry-acetabular-angle = Kąt panewki (Sharpa)
geometry-steiner = Analiza Steinera
geometry-downs = Analiza Downsa

