# machine-drafted, needs native review

## Books (EPUB): the table of contents panel (Alt+T).

contents-title = İçindekiler
# Toast when Alt+T is pressed over a file without a table of contents.
contents-none = Bu dosyanın içindekiler tablosu yok.

## Fonts: the specimen page (TTF, OTF, TTC/OTC, WOFF, WOFF2).

# The specimen's accessible name.
font-specimen = { $family } örneği
# Shown when the font names no family.
font-unnamed = Adsız yazı tipi
font-designer = Tasarımcı: { $value }
font-foundry = Dökümhane: { $value }
font-licence = Lisans: { $value }
font-licence-url = Lisans URL'si: { $value }
# A sentence using every letter of the alphabet, shown at several sizes in the font. Use one
# for the language (translators: any common pangram of your language).
font-pangram = Pijamalı hasta yağız şoföre çabucak güvendi. 0123456789
# Heading of the glyph grid: "Glyphs 1–256 of 1,024".
font-glyphs-range = Glifler { $first }–{ $last } / { $count }
font-glyphs-none = Glif yok
font-glyphs-previous = Önceki glifler
font-glyphs-next = Sonraki glifler
# The row of colour glyphs drawn in colour.
font-colour-row = Renkli glifler
font-note-colr0 = Renkli glifler aşağıdaki satırda renkli çizilir; yukarıdaki metin tek renktir.
font-note-colr1 = COLR sürüm 1 glifleri (geçişler) tek renk çizilir: metin motoru yalnızca COLR sürüm 0 katmanlarını renkli çizer.
font-note-bitmaps = Bit eşlem renkli glifler aşağıdaki satırda renkli çizilir; yukarıdaki metin tek renktir.
font-note-svg = SVG renkli glifler tek renk çizilir: metin motoru SVG gliflerini okumaz.
font-note-no-glyphs = Bu yazı tipinde çizilecek anahat veya bit eşlem yok.
font-note-bitmap-only = Bu yazı tipinde yalnızca siyah beyaz bit eşlemler var; metin motoru bunları çizmez.
