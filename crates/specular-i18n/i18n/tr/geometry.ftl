# machine-drafted, needs native review
# Vet, orthopaedic and cephalometric geometry in the measuring tool. Every point is placed
# by hand; nothing is detected or graded.

measure-tool-geometry = Geometri
measure-tool-hint-geometry = Bir şablon seçin, ardından istediği her noktayı yerleştirin.
measure-tool-template = Şablon: { $name }

geometry-prompt = { $template }, nokta { $n }/{ $total }: { $point }
geometry-readout = { $name }: { $value }
geometry-value-angle = { $value }°
geometry-value-vertebrae = { $value } v
geometry-extrapolated = { $value } (T9 ötesi, tahmini)
geometry-degenerate = Noktalar çok yakın ya da aynı doğru üzerinde. Bir noktayı taşıyın.
geometry-moved = Nokta taşındı. { $value }
# machine-drafted, needs native review
geometry-picked = { $point } noktası alındı. Oklar onu taşır, Shift ile daha büyük adımlarla. Boşluk bırakır, Esc yerine geri koyar.
geometry-put-back = Nokta yerine geri kondu.

