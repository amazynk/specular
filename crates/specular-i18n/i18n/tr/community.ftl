# The Specular Discord server: the toolbar button, its Settings name, the palette and About.
# machine-drafted, needs native review

toolbar-discord = { -app-name } Discord sunucusuna katıl
toolbar-discord-help = { -app-name } Discord sunucusunu tarayıcıda aç.
settings-viewing-toolbar-items-discord = Discord'da { -app-name }

# The other apps by the same people: About names them, and "Get …" opens an app's page in
# the browser. Pagebara, Dozed and Amazynk are names and stay as they are.
# machine-drafted, needs native review

about-more-apps = Amazynk'ten daha fazlası
about-more-apps-pagebara = Pagebara: hızlı ve gizliliğe saygılı bir PDF görüntüleyici ve düzenleyici. Linux, Windows ve macOS için.
about-more-apps-dozed = Dozed: bakmadığınız Linux masaüstü uygulamalarını dondurur, böylece işlemciyi uyandırmayı bırakırlar.
palette-get-pagebara = Pagebara'yı edin
palette-get-pagebara-help = PDF görüntüleyici ve düzenleyici Pagebara'nın sayfasını tarayıcıda aç. İndirmeler oradadır.
palette-get-dozed = Dozed'i edin
palette-get-dozed-help = Linux'ta arka plandaki uygulamaları donduran Dozed'in sayfasını tarayıcıda aç. İndirmeler oradadır.

# Settings › More from Amazynk: a row for each app, named for it, with the same button.
settings-section-amazynk = { about-more-apps }
settings-amazynk-get-zynk = Zynk
settings-amazynk-get-zynk-help = Zynk; Mac, Windows, Linux, iPhone ve Android için ücretsiz bir uygulamadır. Fotoğrafları, videoları ve klasörlerin tamamını, boyutu ne olursa olsun, doğrudan diğer cihazlarınıza ve başka kişilere gönderir.
settings-amazynk-get-zynk-button = { zynk-get }
settings-amazynk-get-pagebara = Pagebara
settings-amazynk-get-pagebara-help = Hızlı ve gizliliğe saygılı bir PDF görüntüleyici ve düzenleyici. Linux, Windows ve macOS için.
settings-amazynk-get-pagebara-button = { palette-get-pagebara }
settings-amazynk-get-dozed = Dozed
settings-amazynk-get-dozed-help = Bakmadığınız Linux masaüstü uygulamalarını dondurur, böylece işlemciyi uyandırmayı bırakırlar.
settings-amazynk-get-dozed-button = { palette-get-dozed }
