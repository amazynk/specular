## Results
# $name is the file or folder written.
# machine-drafted, needs native review
figure-saved = { $name } kaydedildi
# $name is the file or folder written; $count how many images were left out.
# machine-drafted, needs native review
figure-saved-skipped = { $count ->
    [one] { $name } kaydedildi. { $count } görüntü dışarıda bırakıldı: gömülü metni bulunamadı.
   *[other] { $name } kaydedildi. { $count } görüntü dışarıda bırakıldı: gömülü metinleri bulunamadı.
}
# $reason says why.
# machine-drafted, needs native review
figure-failed = Dışa aktarılamadı: { $reason }
# $name is a file that is already in the folder.
# machine-drafted, needs native review
figure-folder-taken = { $name } zaten bu klasörde. Boş bir klasör seçin.

