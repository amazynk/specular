# machine-drafted, needs native review
# Vet, orthopaedic and cephalometric geometry in the measuring tool. Every point is placed
# by hand; nothing is detected or graded.

measure-tool-geometry = Geometria
measure-tool-hint-geometry = Valitse malli ja aseta sitten jokainen sen pyytämä piste.
measure-tool-template = Malli: { $name }

geometry-prompt = { $template }, piste { $n }/{ $total }: { $point }
geometry-readout = { $name }: { $value }
geometry-value-angle = { $value }°
geometry-value-vertebrae = { $value } v
geometry-extrapolated = { $value } (T9:n jälkeen, arvio)
geometry-degenerate = Pisteet ovat liian lähellä toisiaan tai samalla suoralla. Siirrä pistettä.
geometry-moved = Piste siirretty. { $value }
# machine-drafted, needs native review
geometry-picked = Piste { $point } poimittu. Nuolet siirtävät sitä, Shiftillä isommin askelin. Välilyönti laskee sen, Esc palauttaa sen paikalleen.
geometry-put-back = Piste palautettu paikalleen.

# Templates.
geometry-vhs = Nikamasydänindeksi (VHS)
geometry-vlas = Vasemman eteisen koko nikamina (VLAS)
geometry-norberg = Norbergin kulma
geometry-tpa = Sääriluun tasanteen kulma (TPA)
geometry-distraction-index = Distraktioindeksi
geometry-femoral-head = Reisiluun pään ympyrä
geometry-femoral-offset = Reisiluun offset
geometry-leg-length = Raajan pituus
geometry-acetabular-angle = Lonkkamaljan kulma (Sharp)
geometry-steiner = Steiner-analyysi
geometry-downs = Downs-analyysi

# Points, in the order they are asked for.
geometry-pt-long-axis-carina = pitkä akseli, karinan ventraalipuoli
