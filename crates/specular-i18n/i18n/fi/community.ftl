# The Specular Discord server: the toolbar button, its Settings name, the palette and About.
# machine-drafted, needs native review

toolbar-discord = Liity { -app-name }in Discordiin
toolbar-discord-help = Avaa { -app-name }in Discord-palvelin selaimessa.
settings-viewing-toolbar-items-discord = { -app-name } Discordissa

# The other apps by the same people: About names them, and "Get …" opens an app's page in
# the browser. Pagebara, Dozed and Amazynk are names and stay as they are.
# machine-drafted, needs native review

about-more-apps = Lisää Amazynkilta
about-more-apps-pagebara = Pagebara: nopea ja yksityinen PDF-katselin ja -muokkain. Linuxille, Windowsille ja macOS:lle.
about-more-apps-dozed = Dozed: jäädyttää ne Linuxin työpöytäsovellukset, joita et katso, jotta ne eivät enää herätä suoritinta.
palette-get-pagebara = Hanki Pagebara
palette-get-pagebara-help = Avaa selaimessa Pagebaran sivu. Pagebara on PDF-katselin ja -muokkain. Lataukset ovat siellä.
palette-get-dozed = Hanki Dozed
palette-get-dozed-help = Avaa selaimessa Dozedin sivu. Dozed jäädyttää taustasovellukset Linuxissa. Lataukset ovat siellä.

# Settings › More from Amazynk: a row for each app, named for it, with the same button.
settings-section-amazynk = { about-more-apps }
settings-amazynk-get-zynk = Zynk
settings-amazynk-get-zynk-help = Zynk on maksuton sovellus Macille, Windowsille, Linuxille, iPhonelle ja Androidille. Se lähettää kuvia, videoita ja kokonaisia kansioita suoraan muille laitteillesi ja muille ihmisille, minkä kokoisina tahansa.
settings-amazynk-get-zynk-button = { zynk-get }
settings-amazynk-get-pagebara = Pagebara
settings-amazynk-get-pagebara-help = Nopea ja yksityinen PDF-katselin ja -muokkain. Linuxille, Windowsille ja macOS:lle.
settings-amazynk-get-pagebara-button = { palette-get-pagebara }
settings-amazynk-get-dozed = Dozed
settings-amazynk-get-dozed-help = Jäädyttää ne Linuxin työpöytäsovellukset, joita et katso, jotta ne eivät enää herätä suoritinta.
settings-amazynk-get-dozed-button = { palette-get-dozed }
