# machine-drafted, needs native review

## Books (EPUB): the table of contents panel (Alt+T).

contents-title = Sisällys
# Toast when Alt+T is pressed over a file without a table of contents.
contents-none = Tiedostossa ei ole sisällysluetteloa.

## Fonts: the specimen page (TTF, OTF, TTC/OTC, WOFF, WOFF2).

# The specimen's accessible name.
font-specimen = Fonttinäyte: { $family }
# Shown when the font names no family.
font-unnamed = Nimetön fontti
font-designer = Suunnittelija: { $value }
font-foundry = Valmistaja: { $value }
font-licence = Lisenssi: { $value }
font-licence-url = Lisenssin URL: { $value }
# A sentence using every letter of the alphabet, shown at several sizes in the font. Use one
# for the language (translators: any common pangram of your language).
font-pangram = Wieniläinen sioux'ta puhuva ökyzombie diggaa Åsan roquefort-tacoja. 0123456789
# Heading of the glyph grid: "Glyphs 1–256 of 1,024".
font-glyphs-range = Glyfit { $first }–{ $last }/{ $count }
font-glyphs-none = Ei glyfejä
font-glyphs-previous = Edelliset glyfit
font-glyphs-next = Seuraavat glyfit
# The row of colour glyphs drawn in colour.
font-colour-row = Väriglyfit
font-note-colr0 = Väriglyfit piirretään värillisinä alla olevalle riville; yllä oleva teksti on yhtä väriä.
font-note-colr1 = COLR-version 1 glyfit (liukuvärit) piirretään yhdellä värillä: tekstinpiirto piirtää värillisinä vain COLR-version 0 kerrokset.
font-note-bitmaps = Bittikarttaväriglyfit piirretään värillisinä alla olevalle riville; yllä oleva teksti on yhtä väriä.
font-note-svg = SVG-väriglyfit piirretään yhdellä värillä: tekstinpiirto ei lue SVG-glyfejä.
font-note-no-glyphs = Fontissa ei ole piirrettäviä ääriviivoja tai bittikarttoja.
font-note-bitmap-only = Fontissa on vain mustavalkoisia bittikarttoja, joita tekstinpiirto ei piirrä.
