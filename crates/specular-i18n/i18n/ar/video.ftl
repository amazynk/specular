transport-loop-off = إيقاف التكرار
transport-mute = كتم الصوت
transport-unmute = إلغاء كتم الصوت
transport-volume = مستوى الصوت

## الإشعارات

# ‏$percent عدد صحيح، مثل 80.
toast-volume = مستوى الصوت { PERCENT($percent) }
toast-muted = الصوت مكتوم
toast-unmuted = الصوت مفعّل
toast-video-loop-on = تكرار الفيلم
toast-video-loop-off = تشغيل الفيلم مرة واحدة
# يظهر مرة لكل فيلم عند عدم وجود جهاز صوت أو اختفائه؛ يستمر الفيلم.
toast-no-sound-device = لا يوجد جهاز صوت: التشغيل بلا صوت
toast-sound-device-lost = اختفى جهاز الصوت: التشغيل بلا صوت
# ترميز صوت الفيلم لا يمكن لهذا الإصدار تشغيله؛ ‏$codec اسمه، مثل AAC.
toast-sound-unsupported = التشغيل بلا صوت: لا يمكن تشغيل صوت { $codec } بعد
# machine-drafted, needs native review
# The movie's sound decoder stopped part way; $reason is error-reason-internal.
toast-sound-stopped = توقف الصوت: { $reason }

