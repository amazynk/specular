## Progress and the end

# machine-drafted, needs native review
develop-export-progress = جارٍ تصدير { $done } من { $total }
# machine-drafted, needs native review
develop-export-progress-eta = جارٍ تصدير { $done } من { $total } · يتبقى نحو { $time }
# machine-drafted, needs native review
develop-export-done = { $count ->
    [zero] لم تُصدَّر أي صورة
    [one] صُدِّرت صورة واحدة
    [two] صُدِّرت صورتان
    [few] صُدِّرت { $count } صور
    [many] صُدِّرت { $count } صورة
   *[other] صُدِّرت { $count } من الصور
}
# machine-drafted, needs native review
develop-export-stopped = توقف بعد { $count }
# machine-drafted, needs native review
develop-export-running = يوجد تصدير أو تحويل قيد التشغيل بالفعل.
# machine-drafted, needs native review
develop-export-row = تصدير
# machine-drafted, needs native review
develop-export-row-detail = { $done } من { $total }
# machine-drafted, needs native review
