# machine-drafted, needs native review
# Vet, orthopaedic and cephalometric geometry in the measuring tool. Every point is placed
# by hand; nothing is detected or graded.

measure-tool-geometry = الهندسة
measure-tool-hint-geometry = اختر قالبًا، ثم ضع كل نقطة يطلبها.
measure-tool-template = القالب: { $name }

geometry-prompt = { $template }، النقطة { $n } من { $total }: { $point }
geometry-readout = { $name }: { $value }
geometry-value-angle = { $value }°
geometry-value-vertebrae = { $value } فقرة
geometry-extrapolated = { $value } (بعد T9، تقديري)
geometry-degenerate = النقاط متقاربة جدًا أو على خط واحد. حرّك نقطة.
geometry-moved = نُقلت النقطة. { $value }
# machine-drafted, needs native review
geometry-picked = التُقطت النقطة { $point }. الأسهم تحركها، وShift بخطوات أكبر. Space يضعها، وEsc يعيدها إلى مكانها.
geometry-put-back = أُعيدت النقطة إلى مكانها.

