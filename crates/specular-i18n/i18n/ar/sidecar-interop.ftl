# Specular — Other apps' sidecars (sidecar interop 2). العربية.

# machine-drafted, needs native review
info-sidecar-from = من الملف المرافق لـ { $app }
# machine-drafted, needs native review
info-sidecar-from-other = من الملف المرافق لتطبيق آخر
# machine-drafted, needs native review
info-sidecar-file = الملف المرافق: { $file }
# machine-drafted, needs native review
info-sidecar-stars = { $count ->
    [zero] بلا نجوم
    [one] نجمة واحدة
    [two] نجمتان
    [few] { $count } نجوم
    [many] { $count } نجمة
   *[other] { $count } نجمة
}
# machine-drafted, needs native review
info-sidecar-rejected = مرفوضة
# machine-drafted, needs native review
info-sidecar-picked = مختارة
# machine-drafted, needs native review
info-sidecar-keywords = الكلمات المفتاحية: { $keywords }
# machine-drafted, needs native review
info-sidecar-nothing = لا شيء مما يقرؤه Specular
# machine-drafted, needs native review
info-sidecar-duplicates = نسخ darktable المكررة
# machine-drafted, needs native review
info-sidecar-duplicate = { $number }: { $what }
# machine-drafted, needs native review
settings-library-prefer-sidecars-in = تفضيل الملفات المرافقة للتطبيقات الأخرى في
# machine-drafted, needs native review
settings-library-prefer-sidecars-in-help = مجلدات يُفصل بينها بـ ;. فيها تحل التقييمات وتسميات الألوان والاختيارات والكلمات المفتاحية من الملفات المرافقة لـ darktable وLightroom والتطبيقات الأخرى محل ما حددته. وفي غيرها تكمل فقط ما لم تحدده.
# machine-drafted, needs native review
sidecar-other-apps-only = ملفاتها المرافقة تخص تطبيقات أخرى. لا يضيف Specular إليها كلمات مفتاحية أو مواقع.
