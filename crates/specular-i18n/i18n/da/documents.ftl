# machine-drafted, needs native review

## Books (EPUB): the table of contents panel (Alt+T).

contents-title = Indhold
# Toast when Alt+T is pressed over a file without a table of contents.
contents-none = Denne fil har ingen indholdsfortegnelse.

## Fonts: the specimen page (TTF, OTF, TTC/OTC, WOFF, WOFF2).

# The specimen's accessible name.
font-specimen = Skriftprøve af { $family }
# Shown when the font names no family.
font-unnamed = Unavngiven skrifttype
font-designer = Designer: { $value }
font-foundry = Skriftstøberi: { $value }
font-licence = Licens: { $value }
font-licence-url = Licens-URL: { $value }
# A sentence using every letter of the alphabet, shown at several sizes in the font. Use one
# for the language (translators: any common pangram of your language).
font-pangram = Høj bly gom vandt fræk sexquiz på wc. 0123456789
# Heading of the glyph grid: "Glyphs 1–256 of 1,024".
font-glyphs-range = Glyffer { $first }–{ $last } af { $count }
font-glyphs-none = Ingen glyffer
font-glyphs-previous = Forrige glyffer
font-glyphs-next = Næste glyffer
# The row of colour glyphs drawn in colour.
font-colour-row = Farveglyffer
font-note-colr0 = Farveglyffer tegnes i farver i rækken nedenfor; teksten ovenfor er i én farve.
font-note-colr1 = Glyffer i COLR version 1 (forløb) tegnes i én farve: tekstvisningen tegner kun lag i COLR version 0 i farver.
font-note-bitmaps = Bitmap-farveglyffer tegnes i farver i rækken nedenfor; teksten ovenfor er i én farve.
font-note-svg = SVG-farveglyffer tegnes i én farve: tekstvisningen læser ikke SVG-glyffer.
font-note-no-glyphs = Denne skrifttype har ingen konturer eller bitmaps at tegne.
font-note-bitmap-only = Denne skrifttype har kun sort-hvide bitmaps, som tekstvisningen ikke tegner.
