# The Specular Discord server: the toolbar button, its Settings name, the palette and About.
# machine-drafted, needs native review

toolbar-discord = Deltag i { -app-name } på Discord
toolbar-discord-help = Åbn { -app-name }s Discord-server i browseren.
settings-viewing-toolbar-items-discord = { -app-name } på Discord

# The other apps by the same people: About names them, and "Get …" opens an app's page in
# the browser. Pagebara, Dozed and Amazynk are names and stay as they are.
# machine-drafted, needs native review

about-more-apps = Mere fra Amazynk
about-more-apps-pagebara = Pagebara: en hurtig, privat PDF-fremviser og -editor. Til Linux, Windows og macOS.
about-more-apps-dozed = Dozed: fryser de Linux-skrivebordsapps, du ikke kigger på, så de holder op med at vække CPU'en.
palette-get-pagebara = Hent Pagebara
palette-get-pagebara-help = Åbn siden for Pagebara, en PDF-fremviser og -editor, i browseren. Der ligger downloads.
palette-get-dozed = Hent Dozed
palette-get-dozed-help = Åbn siden for Dozed, som fryser baggrundsapps på Linux, i browseren. Der ligger downloads.

# Settings › More from Amazynk: a row for each app, named for it, with the same button.
settings-section-amazynk = { about-more-apps }
settings-amazynk-get-zynk = Zynk
