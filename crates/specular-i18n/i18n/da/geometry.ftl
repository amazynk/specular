# machine-drafted, needs native review
# Vet, orthopaedic and cephalometric geometry in the measuring tool. Every point is placed
# by hand; nothing is detected or graded.

measure-tool-geometry = Geometri
measure-tool-hint-geometry = Vælg en skabelon, og placer derefter hvert punkt, den beder om.
measure-tool-template = Skabelon: { $name }

geometry-prompt = { $template }, punkt { $n } af { $total }: { $point }
geometry-readout = { $name }: { $value }
geometry-value-angle = { $value }°
geometry-value-vertebrae = { $value } v
geometry-extrapolated = { $value } (efter T9, anslået)
geometry-degenerate = Punkterne er for tæt på hinanden eller på linje. Flyt et punkt.
geometry-moved = Punkt flyttet. { $value }
# machine-drafted, needs native review
geometry-picked = Punkt { $point } samlet op. Pile flytter det, med Shift i større skridt. Mellemrum sætter det ned, Esc lægger det tilbage.
geometry-put-back = Punkt lagt tilbage.

# Templates.
geometry-vhs = Vertebral hjertescore (VHS)
geometry-vlas = Vertebral venstre atriestørrelse (VLAS)
geometry-norberg = Norberg-vinkel
geometry-tpa = Tibiaplateauvinkel (TPA)
geometry-distraction-index = Distraktionsindeks
geometry-femoral-head = Lårbenshovedcirkel
