# machine-drafted, needs native review

## Books (EPUB): the table of contents panel (Alt+T).

contents-title = Innehåll
# Toast when Alt+T is pressed over a file without a table of contents.
contents-none = Filen har ingen innehållsförteckning.

## Fonts: the specimen page (TTF, OTF, TTC/OTC, WOFF, WOFF2).

# The specimen's accessible name.
font-specimen = Typsnittsprov för { $family }
# Shown when the font names no family.
font-unnamed = Namnlöst typsnitt
font-designer = Formgivare: { $value }
font-foundry = Stilgjuteri: { $value }
font-licence = Licens: { $value }
font-licence-url = Licens-URL: { $value }
# A sentence using every letter of the alphabet, shown at several sizes in the font. Use one
# for the language (translators: any common pangram of your language).
font-pangram = Flygande bäckasiner söka hwila på mjuka tuvor. 0123456789
# Heading of the glyph grid: "Glyphs 1–256 of 1,024".
font-glyphs-range = Glyfer { $first }–{ $last } av { $count }
font-glyphs-none = Inga glyfer
font-glyphs-previous = Föregående glyfer
font-glyphs-next = Nästa glyfer
# The row of colour glyphs drawn in colour.
font-colour-row = Färgglyfer
font-note-colr0 = Färgglyfer ritas i färg på raden nedan; texten ovan är i en färg.
font-note-colr1 = Glyfer i COLR version 1 (övertoningar) ritas i en färg: textvisningen ritar bara lager i COLR version 0 i färg.
font-note-bitmaps = Bitmappade färgglyfer ritas i färg på raden nedan; texten ovan är i en färg.
font-note-svg = SVG-färgglyfer ritas i en färg: textvisningen läser inte SVG-glyfer.
font-note-no-glyphs = Typsnittet har inga konturer eller bitmappar att rita.
font-note-bitmap-only = Typsnittet har bara svartvita bitmappar, som textvisningen inte ritar.
