## Results
# $name is the file or folder written.
# machine-drafted, needs native review
figure-saved = { $name } sparad
# $name is the file or folder written; $count how many images were left out.
# machine-drafted, needs native review
figure-saved-skipped = { $count ->
    [one] { $name } sparad. { $count } bild utelämnades: dess inbrända text hittades inte.
   *[other] { $name } sparad. { $count } bilder utelämnades: deras inbrända text hittades inte.
}
# $reason says why.
# machine-drafted, needs native review
figure-failed = Kunde inte exportera: { $reason }
# $name is a file that is already in the folder.
# machine-drafted, needs native review
figure-folder-taken = { $name } finns redan i den mappen. Välj en tom mapp.

