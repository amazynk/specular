# The Specular Discord server: the toolbar button, its Settings name, the palette and About.
# machine-drafted, needs native review

toolbar-discord = Gå med i { -app-name }s Discord
toolbar-discord-help = Öppna { -app-name }s Discord-server i webbläsaren.
settings-viewing-toolbar-items-discord = { -app-name } på Discord

# The other apps by the same people: About names them, and "Get …" opens an app's page in
# the browser. Pagebara, Dozed and Amazynk are names and stay as they are.
# machine-drafted, needs native review

about-more-apps = Mer från Amazynk
about-more-apps-pagebara = Pagebara: en snabb, privat PDF-visare och PDF-redigerare. För Linux, Windows och macOS.
about-more-apps-dozed = Dozed: fryser de skrivbordsappar i Linux som du inte tittar på, så att de slutar väcka processorn.
palette-get-pagebara = Hämta Pagebara
palette-get-pagebara-help = Öppna sidan för Pagebara, en PDF-visare och PDF-redigerare, i webbläsaren. Där finns hämtningarna.
palette-get-dozed = Hämta Dozed
palette-get-dozed-help = Öppna sidan för Dozed, som fryser bakgrundsappar i Linux, i webbläsaren. Där finns hämtningarna.

# Settings › More from Amazynk: a row for each app, named for it, with the same button.
settings-section-amazynk = { about-more-apps }
settings-amazynk-get-zynk = Zynk
settings-amazynk-get-zynk-help = Zynk är en gratis app för Mac, Windows, Linux, iPhone och Android. Den skickar foton, videor och hela mappar direkt till dina andra enheter och till andra personer, oavsett storlek.
settings-amazynk-get-zynk-button = { zynk-get }
settings-amazynk-get-pagebara = Pagebara
settings-amazynk-get-pagebara-help = En snabb, privat PDF-visare och PDF-redigerare. För Linux, Windows och macOS.
settings-amazynk-get-pagebara-button = { palette-get-pagebara }
settings-amazynk-get-dozed = Dozed
settings-amazynk-get-dozed-help = Fryser de skrivbordsappar i Linux som du inte tittar på, så att de slutar väcka processorn.
settings-amazynk-get-dozed-button = { palette-get-dozed }
