# machine-drafted, needs native review
# Vet, orthopaedic and cephalometric geometry in the measuring tool. Every point is placed
# by hand; nothing is detected or graded.

measure-tool-geometry = Geometri
measure-tool-hint-geometry = Välj en mall och placera sedan varje punkt den ber om.
measure-tool-template = Mall: { $name }

geometry-prompt = { $template }, punkt { $n } av { $total }: { $point }
geometry-readout = { $name }: { $value }
geometry-value-angle = { $value }°
geometry-value-vertebrae = { $value } v
geometry-extrapolated = { $value } (bortom T9, uppskattat)
geometry-degenerate = Punkterna ligger för nära varandra eller på en linje. Flytta en punkt.
geometry-moved = Punkten flyttad. { $value }
# machine-drafted, needs native review
geometry-picked = Punkten { $point } upplockad. Pilarna flyttar den, med Shift i större steg. Blanksteg släpper den, Esc lägger tillbaka den.
geometry-put-back = Punkten lades tillbaka.

# Templates.
geometry-vhs = Vertebral hjärtpoäng (VHS)
geometry-vlas = Vertebral vänster förmaksstorlek (VLAS)
geometry-norberg = Norbergvinkel
geometry-tpa = Tibiaplatåvinkel (TPA)
geometry-distraction-index = Distraktionsindex
geometry-femoral-head = Lårbenshuvudets cirkel
geometry-femoral-offset = Femoral offset
geometry-leg-length = Benlängd
geometry-acetabular-angle = Acetabulumvinkel (Sharp)
geometry-steiner = Steineranalys
geometry-downs = Downsanalys

# Points, in the order they are asked for.
geometry-pt-long-axis-carina = långaxel, ventrala carina
geometry-pt-long-axis-apex = långaxel, hjärtspets
geometry-pt-short-axis = kortaxel, ände { $n }
