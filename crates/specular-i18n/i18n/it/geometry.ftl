# machine-drafted, needs native review
# Vet, orthopaedic and cephalometric geometry in the measuring tool. Every point is placed
# by hand; nothing is detected or graded.

measure-tool-geometry = Geometria
measure-tool-hint-geometry = Scegli un modello, poi posiziona ogni punto richiesto.
measure-tool-template = Modello: { $name }

geometry-prompt = { $template }, punto { $n } di { $total }: { $point }
geometry-readout = { $name }: { $value }
geometry-value-angle = { $value }°
geometry-value-vertebrae = { $value } v
geometry-extrapolated = { $value } (oltre T9, stimato)
geometry-degenerate = Punti troppo vicini o allineati. Sposta un punto.
geometry-moved = Punto spostato. { $value }
# machine-drafted, needs native review
geometry-picked = Punto { $point } preso. Le frecce lo spostano, Shift a passi più grandi. Spazio lo posa, Esc lo rimette a posto.
geometry-put-back = Punto rimesso a posto.

# Templates.
geometry-vhs = Punteggio cardiaco vertebrale (VHS)
geometry-vlas = Dimensione vertebrale dell’atrio sinistro (VLAS)
geometry-norberg = Angolo di Norberg
geometry-tpa = Angolo del plateau tibiale (TPA)
geometry-distraction-index = Indice di distrazione
geometry-femoral-head = Cerchio della testa femorale
