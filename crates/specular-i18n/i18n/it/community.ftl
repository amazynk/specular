# The Specular Discord server: the toolbar button, its Settings name, the palette and About.
# machine-drafted, needs native review

toolbar-discord = Unisciti al Discord di { -app-name }
toolbar-discord-help = Apri il server Discord di { -app-name } nel browser.
settings-viewing-toolbar-items-discord = { -app-name } su Discord

# The other apps by the same people: About names them, and "Get …" opens an app's page in
# the browser. Pagebara, Dozed and Amazynk are names and stay as they are.
# machine-drafted, needs native review

about-more-apps = Altro da Amazynk
about-more-apps-pagebara = Pagebara: un visualizzatore ed editor di PDF veloce e privato. Per Linux, Windows e macOS.
about-more-apps-dozed = Dozed: congela le app desktop di Linux che non stai guardando, così smettono di risvegliare la CPU.
palette-get-pagebara = Ottieni Pagebara
palette-get-pagebara-help = Apri nel browser la pagina di Pagebara, un visualizzatore ed editor di PDF. I download sono lì.
palette-get-dozed = Ottieni Dozed
palette-get-dozed-help = Apri nel browser la pagina di Dozed, che congela le app in background su Linux. I download sono lì.

# Settings › More from Amazynk: a row for each app, named for it, with the same button.
settings-section-amazynk = { about-more-apps }
settings-amazynk-get-zynk = Zynk
settings-amazynk-get-zynk-help = Zynk è un’app gratuita per Mac, Windows, Linux, iPhone e Android. Invia foto, video e intere cartelle direttamente agli altri tuoi dispositivi e ad altre persone, di qualsiasi dimensione.
settings-amazynk-get-zynk-button = { zynk-get }
settings-amazynk-get-pagebara = Pagebara
settings-amazynk-get-pagebara-help = Un visualizzatore ed editor di PDF veloce e privato. Per Linux, Windows e macOS.
settings-amazynk-get-pagebara-button = { palette-get-pagebara }
settings-amazynk-get-dozed = Dozed
settings-amazynk-get-dozed-help = Congela le app desktop di Linux che non stai guardando, così smettono di risvegliare la CPU.
settings-amazynk-get-dozed-button = { palette-get-dozed }
