# machine-drafted, needs native review

## Books (EPUB): the table of contents panel (Alt+T).

contents-title = Indice
# Toast when Alt+T is pressed over a file without a table of contents.
contents-none = Questo file non ha un indice.

## Fonts: the specimen page (TTF, OTF, TTC/OTC, WOFF, WOFF2).

# The specimen's accessible name.
font-specimen = Campione di { $family }
# Shown when the font names no family.
font-unnamed = Font senza nome
font-designer = Designer: { $value }
font-foundry = Fonderia: { $value }
font-licence = Licenza: { $value }
font-licence-url = URL della licenza: { $value }
# A sentence using every letter of the alphabet, shown at several sizes in the font. Use one
# for the language (translators: any common pangram of your language).
font-pangram = Quel vituperabile xenofobo zelante assaggia il whisky ed esclama: alleluja! 0123456789
# Heading of the glyph grid: "Glyphs 1–256 of 1,024".
font-glyphs-range = Glifi { $first }–{ $last } di { $count }
font-glyphs-none = Nessun glifo
font-glyphs-previous = Glifi precedenti
font-glyphs-next = Glifi successivi
# The row of colour glyphs drawn in colour.
font-colour-row = Glifi a colori
font-note-colr0 = I glifi a colori sono disegnati a colori nella riga sotto; il testo sopra è in un solo colore.
font-note-colr1 = I glifi COLR versione 1 (sfumature) sono disegnati in un solo colore: il motore del testo disegna a colori solo i livelli COLR versione 0.
font-note-bitmaps = I glifi bitmap a colori sono disegnati a colori nella riga sotto; il testo sopra è in un solo colore.
font-note-svg = I glifi SVG a colori sono disegnati in un solo colore: il motore del testo non legge i glifi SVG.
font-note-no-glyphs = Questo font non ha contorni né bitmap da disegnare.
font-note-bitmap-only = Questo font ha solo bitmap in bianco e nero, che il motore del testo non disegna.
